#!/usr/bin/env python3
"""Battery state for Steam in /run/vpower, where the Frame's own charger
daemon (deckard-charger, masked here: it drives the Frame's charger IC) keeps
it. Without these files Steam shows "?h ?m" while charging. Read straight from
the battery's power_supply node every 5 s."""
import glob
import os
import time

OUT = "/run/vpower"


def rd(path, default=""):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return default


def num(path):
    try:
        return int(rd(path))
    except ValueError:
        return None


def battery():
    for d in sorted(glob.glob("/sys/class/power_supply/*")):
        if rd(f"{d}/type") == "Battery" and rd(f"{d}/present", "1") == "1":
            return d
    return None


def ac_online():
    for d in glob.glob("/sys/class/power_supply/*"):
        if rd(f"{d}/type") in ("Mains", "USB", "USB_PD", "USB_C") and rd(f"{d}/online") == "1":
            return True
    return False


def estimates(b, status):
    """(secs to full, secs to empty), -1 when unknown."""
    full = empty = -1
    # The kernel's own estimate first: qcom_battmgr's _avg values know the
    # charge limit (our patch 0050); other drivers have _now.
    t_full = next((v for v in (num(f"{b}/time_to_full_avg"), num(f"{b}/time_to_full_now")) if v and v > 0), None)
    t_empty = next((v for v in (num(f"{b}/time_to_empty_avg"), num(f"{b}/time_to_empty_now")) if v and v > 0), None)
    if status == "Charging" and t_full and t_full > 0:
        full = t_full
    if status == "Discharging" and t_empty and t_empty > 0:
        empty = t_empty
    # Charge counters (our qcom_battmgr patches report charge_now/current_now).
    now, cap, cur = num(f"{b}/charge_now"), num(f"{b}/charge_full"), num(f"{b}/current_now")
    if cur:
        cur = abs(cur)
        if full < 0 and status == "Charging" and now is not None and cap:
            full = int(max(0, cap - now) * 3600 / cur)
        if empty < 0 and status == "Discharging" and now:
            empty = int(now * 3600 / cur)
    return full, empty


def write(name, value):
    tmp = f"{OUT}/.{name}"
    with open(tmp, "w") as fh:
        fh.write(f"{value}\n")
    os.replace(tmp, f"{OUT}/{name}")


def main():
    os.makedirs(OUT, exist_ok=True)
    last = None
    while True:
        b = battery()
        if b:
            status = rd(f"{b}/status", "Unknown")
            pct = num(f"{b}/capacity")
            full, empty = estimates(b, status)
            vals = {
                "ac_status": "Connected" if ac_online() else "Disconnected",
                "battery_percent": f"{pct if pct is not None else 0:.2f}",
                "battery_status": status,
                "secs_until_battery_full": full,
                "secs_until_shutdown_request": empty,
            }
            if vals != last:
                for k, v in vals.items():
                    write(k, v)
                last = vals
        time.sleep(5)


if __name__ == "__main__":
    main()
