#!/bin/bash
# REDMAGIC 6 back lights:
#   logo (pm8350c tri-LED, rgb:status)          always red
#   strip (AW22118, nx669j:rgb:indicator)       green on a charger, red otherwise
#
# The strip only runs Nubia's effect scripts, and those all breathe. Steady
# versions are made here from the user's own aw_cfg_c0.bin (Nubia's files
# cannot be redistributed): both fades ff->ff and no dip before the loop.
# They go to firmware_class.path, which the kernel searches first.
set -u

LOGO=/sys/class/leds/rgb:status
STRIP=/sys/class/leds/nx669j:rgb:indicator
SRC=/usr/lib/firmware/nubia/nx669j/aw22xxx/aw_cfg_c0.bin
OUT=/var/lib/steamos-arm/firmware/nubia/nx669j/aw22xxx

log() { echo "nx669j-lights: $*" >&2; }

make_static() {  # name RRGGBB
  python3 - "$SRC" "$OUT/aw_cfg_$1.bin" "$2" <<'PY'
import sys
src, out, rgb = sys.argv[1], sys.argv[2], bytes.fromhex(sys.argv[3])
d = bytearray(open(src, 'rb').read())
# TASK1 (0x06) writes carry the effect parameters, one byte each
par = [i + 1 for i in range(0, len(d) - 1, 2) if d[i] == 0x06]
p = bytes(d[i] for i in par)
# fade in 00->ff, hold, fade out ff->00, hold at 0 (the loop's flicker)
old = bytes.fromhex('03c000ff0014ffff03c0ff0000140000')
new = bytes.fromhex('03c0ffff0014ffff03c0ffff0014ffff')
k = p.find(old)
if k < 0 or p.find(old, k + 1) >= 0 or p[9] != 5:
    sys.exit(f'{src}: not the expected 5-LED c-family script')
for j, b in enumerate(new):
    d[par[k + j]] = b
for led in range(5):  # 5 RGB colours from parameter 25
    for c in range(3):
        d[par[25 + 3 * led + c]] = rgb[c]
open(out, 'wb').write(d)
PY
}

strip_set() {  # effect
  [[ -e $STRIP ]] || return 0
  echo "$1" >"$STRIP/effect" && echo 255 >"$STRIP/brightness"
}

on_charger() {
  local p
  for p in /sys/class/power_supply/*; do
    case "$(cat "$p/type" 2>/dev/null)" in
      USB|Mains|Wireless) [[ "$(cat "$p/online" 2>/dev/null)" == 1 ]] && return 0 ;;
    esac
  done
  return 1
}

off() {
  [[ -e $STRIP ]] && echo 0 >"$STRIP/brightness"
  [[ -e $LOGO ]] && echo 0 >"$LOGO/brightness"
  exit 0
}

if [[ ${1:-} == stop ]]; then off; fi

for _ in $(seq 30); do [[ -e $LOGO && -e $STRIP ]] && break; sleep 1; done
[[ -e $LOGO ]] || log "no $LOGO"
[[ -e $STRIP ]] || log "no $STRIP"

red=c0 green=c3
if [[ -f $SRC ]] && mkdir -p "$OUT" &&
   make_static static_red ff0000 && make_static static_green 00ff00; then
  red=static_red green=static_green
else
  log "no steady scripts (missing $SRC?), using Nubia's breathing c0/c3"
fi

if [[ -e $LOGO ]]; then
  echo "255 0 0" >"$LOGO/multi_intensity"
  cat "$LOGO/max_brightness" >"$LOGO/brightness"
fi

trap off TERM INT
state=
while :; do
  if on_charger; then want=$green; else want=$red; fi
  if [[ $want != "$state" ]]; then
    strip_set "$want" && state=$want && log "strip: $want"
  fi
  # wake on power_supply uevents, re-check at least every minute
  read -r -t 60 _ <&3 || true
  while read -r -t 0.2 _ <&3; do :; done
done 3< <(udevadm monitor --udev --subsystem-match=power_supply)
