# REDMAGIC 6: SteamOS's home.mount wants a separate "home" partition set
# (/dev/disk/by-partsets/shared/home). Here /home is a directory on the one
# userdata partition; this bind of /home onto itself stands in for it so the
# units that need home.mount (offload mounts, the steamos session) start.
[Unit]
Description=Home Directory (on the root partition)
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target umount.target

[Mount]
What=/home
Where=/home
Type=none
Options=bind
