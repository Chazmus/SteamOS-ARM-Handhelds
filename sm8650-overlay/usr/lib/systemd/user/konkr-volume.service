[Unit]
Description=KONKR Pocket FIT speaker volume curve
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service
ConditionPathExists=/sys/firmware/devicetree/base/model
# root's user manager (SSH logins) has no PipeWire session
ConditionUser=!root

[Service]
# Pocket FIT only. The Pocket S2 has the same card, but its speakers don't
# follow the WSA digital volume, so with softVolumes held at 1.0 the bar
# barely changed anything there (issue #47). It gets PipeWire's own software
# volume instead (api.alsa.soft-mixer in 53-konkr-audio.conf).
ExecCondition=/bin/sh -c 'grep -qa "KONKR Pocket FIT" /sys/firmware/devicetree/base/model'
ExecStart=/usr/lib/konkr/konkr-volume
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
