[Unit]
# Only the player's session: a root login (SSH, the updater) starts a
# user manager for root too, which ran these as root every time.
ConditionUser=!root
Description=Android (Lepton) for konkr-apk apps

[Service]
ExecStart=/usr/bin/konkr-apk daemon
# SIGTERM only to konkr-apk, which has Lepton kill its container cleanly.
KillMode=mixed
TimeoutStopSec=30
