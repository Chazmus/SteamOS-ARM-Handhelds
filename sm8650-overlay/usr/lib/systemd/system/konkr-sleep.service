[Unit]
Description=Kernel sleep preparation (Wi-Fi, touch, audio, wake sources)
Before=sleep.target
StopWhenUnneeded=yes
ConditionPathExists=/usr/lib/konkr/konkr-sleep

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/bin/sh -c '[ "$(/usr/lib/konkr/sleep-mode)" = s2idle ]'
ExecStart=/usr/lib/konkr/konkr-sleep pre
ExecStop=/usr/lib/konkr/konkr-sleep post
TimeoutSec=30

[Install]
WantedBy=sleep.target
