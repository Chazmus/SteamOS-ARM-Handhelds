[Unit]
Description=Handheld platform daemon (fan curve, profiles, extra buttons, LEDs)
ConditionPathExists=/sys/firmware/devicetree/base/model
After=systemd-udev-settle.service inputplumber.service
Wants=inputplumber.service

[Service]
Type=simple
ExecStart=/usr/lib/konkr/konkrd
# Never leave the fan at a low fixed speed if the daemon goes away.
ExecStopPost=/bin/sh -c 'for d in /sys/class/hwmon/hwmon*; do case "$(cat $d/name 2>/dev/null)" in pwmfan|nx669j_fan) echo 255 > $d/pwm1;; esac; done; true'
Restart=always
RestartSec=2
Nice=-5

[Install]
WantedBy=multi-user.target
