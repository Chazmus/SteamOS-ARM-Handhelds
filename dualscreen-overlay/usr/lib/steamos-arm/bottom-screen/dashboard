        elif path == ["webapp"]:
            # Add ({"name", "url"}) or remove ({"remove": id}) your own web app.
            cfg = load_config()
            apps = [w for w in cfg.get("webapps", []) if isinstance(w, dict)]
            if b.get("remove"):
                apps = [w for w in apps if w.get("id") != b["remove"]]
                APPS.close(f"web:u-{b['remove']}")
            else:
                name, url = str(b.get("name", "")).strip()[:40], str(b.get("url", "")).strip()
                if url and "://" not in url:
                    url = "https://" + url
                if not name or not re.match(r"https?://[^\s]+$", url):
                    self.reply({"ok": False, "error": "a name and a web address"})
                    return
                apps.append({"id": secrets.token_hex(4), "name": name, "url": url})
            cfg["webapps"] = apps
            save_config(cfg)
