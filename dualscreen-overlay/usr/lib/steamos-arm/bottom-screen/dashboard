def guide_url(name: str) -> str:
    import urllib.parse
    if not name:
        return "https://www.pcgamingwiki.com"
    return "https://duckduckgo.com/?q=" + urllib.parse.quote_plus(f"{name} guide walkthrough")


def web_entries(cfg: dict) -> list[dict]:
    out = [{"id": f"web:{k}", "name": v["name"], "icon": v["icon"], "web": True}
           for k, v in BUILTIN_WEB.items()]
    for w in cfg.get("webapps", []):
        out.append({"id": f"web:u-{w['id']}", "name": w["name"], "icon": "applications-internet", "web": True})
    return out


def web_target(web_id: str, cfg: dict) -> tuple[str, str] | None:
    """(name, url) for a web tile."""
    key = web_id[4:]
    if key == "guide":
        st = GAMES.state(cfg)
        return ("Guide · " + st["name"]) if st["name"] else "Game Guide", guide_url(st["name"])
    if key in BUILTIN_WEB:
        return BUILTIN_WEB[key]["name"], BUILTIN_WEB[key]["url"]
    for w in cfg.get("webapps", []):
        if f"u-{w['id']}" == key:
            return w["name"], w["url"]
    return None


