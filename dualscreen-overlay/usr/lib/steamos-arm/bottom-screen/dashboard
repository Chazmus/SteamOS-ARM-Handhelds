def composite_devices() -> list[str]:
    tree = run("busctl", "tree", "--list", "org.shadowblip.InputPlumber")
    return sorted(set(re.findall(r"/org/shadowblip/InputPlumber/CompositeDevice\d+", tree)),
                  key=lambda p: int(re.search(r"\d+$", p).group()))


def steam_button(action: str) -> bool:
    chord = STEAM_BUTTONS.get(action)
    if not chord:
        return False
    for dev in composite_devices():   # the built-in pad is the first one made at boot
        r = subprocess.run(["busctl", "call", "org.shadowblip.InputPlumber", dev,
                            "org.shadowblip.Input.CompositeDevice", "SendButtonChord",
                            "as", str(len(chord)), *chord],
                           capture_output=True, text=True, timeout=5)
        if r.returncode == 0:
            return True
        log(f"SendButtonChord on {dev}: {r.stderr.strip()}")
    return False


def konkrd(action: str) -> bool:
    if action not in KONKRD_ACTIONS and not re.fullmatch(r"fan-fixed:\d{1,3}", action):
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as s:
            s.sendto(action.encode(), KONKRD_SOCK)
        return True
    except OSError as exc:
        log(f"konkrd: {exc}")
        return False


# ------------------------------------------------------------------ apps ----
# First match wins, in the order the desktop uses (XDG_DATA_DIRS puts the
# flatpak exports ahead of /usr): the Frame ships an "Install Firefox" stub as
# /usr/share/applications/org.mozilla.firefox.desktop, the same name as the
# real Firefox flatpak's, and scanning /usr first hid Firefox once installed.
APP_DIRS = [Path.home() / ".local/share/applications",
            Path.home() / ".local/share/flatpak/exports/share/applications",
            Path("/var/lib/flatpak/exports/share/applications"),
            Path("/usr/local/share/applications"), Path("/usr/share/applications")]
SKIP_CATEGORIES = {"Settings", "System"}
# Would fight the Game Mode session (a second Steam, session switches) or are
# dev/debug tools with no place on a handheld's second screen.
SKIP_APPS = {"steam", "steamos-gamemode", "deckard-nested-desktop", "bssh", "bvnc",
             "avahi-discover", "cmake-gui", "qv4l2", "qvidcap", "renderdoc", "vim", "gvim",
             "org.kde.plasma.emojier"}


def parse_desktop(path: Path) -> dict | None:
    entry, section = {}, None
    try:
        text = path.read_text(errors="replace")
    except OSError:
        return None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            section = line
            continue
        if section != "[Desktop Entry]" or "=" not in line:
            continue
        k, v = line.split("=", 1)
        entry.setdefault(k.strip(), v.strip())
    if entry.get("Type") != "Application" or entry.get("NoDisplay") == "true" \
            or entry.get("Hidden") == "true" or entry.get("Terminal") == "true" \
            or not entry.get("Exec") or path.stem in SKIP_APPS:
        return None
    if "OnlyShowIn" in entry and "KDE" not in entry["OnlyShowIn"]:
        return None
    return {"id": path.stem, "name": entry.get("Name", path.stem), "icon": entry.get("Icon", ""),
            "exec": entry["Exec"], "categories": entry.get("Categories", "")}


_APPS_CACHE: tuple[tuple, list[dict]] = ((), [])


def list_apps() -> list[dict]:
    """Every launchable app, re-read only when an app folder changed."""
    global _APPS_CACHE
    key = tuple(d.stat().st_mtime_ns if d.is_dir() else 0 for d in APP_DIRS)
    if key == _APPS_CACHE[0]:
        return _APPS_CACHE[1]
    apps = _list_apps()
    _APPS_CACHE = (key, apps)
    return apps


def _list_apps() -> list[dict]:
    seen: dict[str, dict] = {}
    for d in APP_DIRS:
        for f in sorted(d.glob("*.desktop")) if d.is_dir() else []:
            if f.stem in seen:
                continue
            app = parse_desktop(f)
            if app and not SKIP_CATEGORIES & set(app["categories"].split(";")):
                app["path"] = str(f)
                seen[f.stem] = app
    return sorted(seen.values(), key=lambda a: a["name"].lower())


def app_by_id(app_id: str) -> dict | None:
    return next((a for a in list_apps() if a["id"] == app_id), None)


class Apps:
    """Apps started on the bottom panel and their X11 windows."""

    def __init__(self):
        self.procs: dict[str, subprocess.Popen] = {}
        self.flatpak: dict[str, str] = {}     # app -> flatpak id, for close
        self.lock = threading.Lock()

    def launch(self, app_id: str) -> bool:
        with self.lock:
            p = self.procs.get(app_id)
            if p and p.poll() is None:
                return focus_app(app_id, self)
            if app_id.startswith("web:"):
                target = web_target(app_id, load_config())
                if not target:
                    return False
                argv = ["qml6", str(QML.parent / "WebApp.qml"), "--", target[0], target[1], app_id[4:]]
            else:
                app = app_by_id(app_id)
                if not app:
                    return False
                argv = [a for a in shlex.split(app["exec"]) if not re.fullmatch(r"%[a-zA-Z]", a)]
            env = dict(os.environ)
            if app_id.startswith("web:"):
                # Same as the UI: EGL straight on the GPU, the KDE theme.
                env.update(QT_XCB_GL_INTEGRATION="xcb_egl", DISABLE_GAMESCOPE_WSI="1",
                           QT_QPA_PLATFORMTHEME="kde", XDG_CURRENT_DESKTOP="KDE")
            # Plain X11 on the bottom gamescope's Xwayland, never the Game Mode one.
            env.update(QT_QPA_PLATFORM="xcb", GDK_BACKEND="x11", SDL_VIDEODRIVER="x11",
                       MOZ_ENABLE_WAYLAND="0", ELECTRON_OZONE_PLATFORM_HINT="x11")
            env.pop("WAYLAND_DISPLAY", None)
            # Accessibility on for this app only, so the keyboard sees its text
            # fields (GTK/Firefox, Qt). Flatpak apps take it through --env.
            a11y = {"GNOME_ACCESSIBILITY": "1", "QT_ACCESSIBILITY": "1",
                    "QT_LINUX_ACCESSIBILITY_ALWAYS_ON": "1"}
            env.update(a11y)
            if os.path.basename(argv[0]) == "flatpak" and "run" in argv:
                i = argv.index("run") + 1
                argv[i:i] = [f"--env={k}={v}" for k, v in a11y.items()]
                ref = next((a for a in argv[i:] if not a.startswith("-")), "")
                if ref:
                    self.flatpak[app_id] = ref
            KEYBOARD.set(False)
            try:
                self.procs[app_id] = subprocess.Popen(argv, env=env, start_new_session=True,
                                                      stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            except OSError as exc:
                log(f"launch {app_id}: {exc}")
                return False
            log(f"launched {app_id} ({argv[0]})")
            set_base_window(None)       # newest window gets the screen
            NAV.app_in_front(app_id)
            return True

    def running(self) -> list[str]:
        with self.lock:
            return [a for a, p in self.procs.items() if p.poll() is None]

    def close(self, app_id: str) -> bool:
        with self.lock:
            p = self.procs.get(app_id)
            if not p or p.poll() is not None:
                return False
            # A flatpak app runs in flatpak's sandbox (bwrap), outside our
            # process group, so a SIGTERM to the group can miss it.
            ref = self.flatpak.get(app_id)
            if ref:
                run("flatpak", "kill", ref, timeout=10)
            try:
                os.killpg(p.pid, signal.SIGTERM)
            except OSError:
                pass
        NAV.app_closed(app_id)
        return True

    def pids(self, app_id: str) -> set[int]:
        with self.lock:
            p = self.procs.get(app_id)
        if not p or p.poll() is not None:
            return set()
        return {p.pid} | descendants(p.pid)


def descendants(pid: int) -> set[int]:
    children: dict[int, list[int]] = {}
    for stat in glob.glob("/proc/[0-9]*/stat"):
        try:
            fields = Path(stat).read_text().rsplit(")", 1)[1].split()
            children.setdefault(int(fields[1]), []).append(int(stat.split("/")[2]))
        except (OSError, IndexError, ValueError):
            continue
    out, todo = set(), [pid]
    while todo:
        for c in children.get(todo.pop(), []):
            if c not in out:
                out.add(c)
                todo.append(c)
    return out


# --------------------------------------------------------------- windows ----
def toplevel_windows() -> list[tuple[str, str]]:
    """(id, title) of mapped top-level windows on this Xwayland."""
    out = []
    for line in run("xwininfo", "-root", "-children").splitlines():
        m = re.match(r'\s+(0x[0-9a-f]+) "([^"]*)"', line)
        if m:
            out.append((m.group(1), m.group(2)))
    return out


def window_pid(wid: str) -> int:
    m = re.search(r"= (\d+)", run("xprop", "-id", wid, "_NET_WM_PID"))
    return int(m.group(1)) if m else -1


# Whether the dashboard itself is on the bottom panel. While an app covers it,
# /state skips sampling the stats (the UI keeps polling for the app rows), so
# a hidden dashboard costs next to nothing.
DASHBOARD_SHOWN = threading.Event()
DASHBOARD_SHOWN.set()


def set_base_window(wid: str | None, dashboard: bool = False) -> None:
    if dashboard:
        DASHBOARD_SHOWN.set()
    else:
        DASHBOARD_SHOWN.clear()
    if wid:
        run("xprop", "-root", "-f", "GAMESCOPECTRL_BASELAYER_WINDOW", "32c",
            "-set", "GAMESCOPECTRL_BASELAYER_WINDOW", str(int(wid, 16)))
    else:
        run("xprop", "-root", "-remove", "GAMESCOPECTRL_BASELAYER_WINDOW")


def show_dashboard() -> None:
    KEYBOARD.set(False)
    for wid, title in toplevel_windows():
        if title == WINDOW_TITLE:
            set_base_window(wid, dashboard=True)
            return


def focus_app(app_id: str, apps: Apps) -> bool:
    pids = apps.pids(app_id)
    for wid, title in toplevel_windows():
        if title and title != WINDOW_TITLE and window_pid(wid) in pids:
            set_base_window(wid)
            NAV.app_in_front(app_id)
            return True
    return False


class Nav:
    """Which page our window shows and which app is in front.

    The UI follows `page` whenever `serial` changes, so the backend can send
    it somewhere (AYN button, swipe home). The AYN button's short press opens
    the dashboard over the app in front and a second press (or the idle
    timeout) hands the screen back to it."""

    def __init__(self):
        self.lock = threading.Lock()
        self.page = "home"
        self.serial = 0
        self.front: str | None = None     # app in front of our window
        self.under: str | None = None     # app the dashboard was opened over

    def state(self) -> dict:
        with self.lock:
            return {"page": self.page, "serial": self.serial,
                    "front": self.front, "under": self.under}

    def show(self, page: str) -> None:
        with self.lock:
            self.page, self.serial, self.front = page, self.serial + 1, None
            if page != "dash":
                self.under = None
        show_dashboard()

    def ui_page(self, page: str) -> None:
        """The UI moved itself (a tile, a back button)."""
        with self.lock:
            self.page = page
            if page != "dash":
                self.under = None

    def app_in_front(self, app_id: str) -> None:
        with self.lock:
            self.front, self.under = app_id, None

    def app_closed(self, app_id: str) -> None:
        with self.lock:
            if self.under == app_id:
                self.under = None
            front = self.front
        if front == app_id or front is None:
            self.show("home")

    def home(self) -> None:
        self.show("home")

    def toggle_dash(self) -> None:
        with self.lock:
            on_dash = self.front is None and self.page == "dash"
            under = self.under
            front = self.front
        if on_dash:
            self.back_from_dash(under)
            return
        self.show("dash")
        with self.lock:
            self.under = front

    def back_from_dash(self, under: str | None = None) -> None:
        if under is None:
            under = self.state()["under"]
        if under and under in APPS.running() and focus_app(under, APPS):
            return
        self.show("home")


NAV = Nav()
DASH_TOGGLE = RUNTIME / "bottom-screen.dash"


def watch_home_gesture() -> None:
    """GAMESCOPE_HOME_GESTURE (swipe up from the bottom edge) and konkrd's
    AYN-key files: .home (held) and .dash (short press)."""
    files = {HOME_GESTURE: NAV.home, DASH_TOGGLE: NAV.toggle_dash}
    last = {f: (f.stat().st_mtime if f.exists() else 0.0) for f in files}
    while True:
        time.sleep(0.12)
        for f, act in files.items():
            try:
                m = f.stat().st_mtime
            except OSError:
                continue
            if m != last[f]:
                last[f] = m
                try:
                    act()
                except Exception as exc:   # never stop watching
                    log(f"{f.name}: {exc}")


# ----------------------------------------------------------- idle nudge ----
# Touches on the bottom panel go to this gamescope, not Steam's, so Steam sees
# no input and dims (then sleeps) the device while you use the dashboard.
# Watch the bottom touchscreen (no grab) and, at most every NUDGE_S, tap right
# Shift on Steam's X display through XTEST, which Steam counts as input.
NUDGE_S = 20
# The keyboard pops up for a text field only if a finger was on the panel
# this recently: apps that focus a field by themselves (a chat opening on its
# message box) shouldn't cover the screen with keys nobody asked for.
TOUCH_GRACE_S = 1.5
last_touch = 0.0
EVENT_SIZE = 24  # struct input_event on 64-bit
EV_KEY, EV_ABS = 1, 3
XK_SHIFT_R = 0xFFE2


def touch_event_nodes() -> list[str]:
    """/dev/input/event* for the entries in GAMESCOPE_INPUT_ONLY (names, or
    path:<part of the sysfs path>), the same list this gamescope uses."""
    want = [w for w in os.environ.get("GAMESCOPE_INPUT_ONLY", "").split(",") if w and w != "none"]
    out = []
    for ev in glob.glob("/sys/class/input/event*"):
        name = rd(f"{ev}/device/name")
        syspath = os.path.realpath(f"{ev}/device")
        for w in want:
            if (w.startswith("path:") and w[5:] in syspath) or w == name:
                out.append(f"/dev/input/{os.path.basename(ev)}")
                break
    return out


def steam_display() -> str:
    """DISPLAY of the running Steam client (Game Mode's Xwayland)."""
    uid = os.getuid()
    for pid in os.listdir("/proc"):
        if not pid.isdigit() or rd(f"/proc/{pid}/comm") != "steam":
            continue
        try:
            if os.stat(f"/proc/{pid}").st_uid != uid:
                continue
            env = open(f"/proc/{pid}/environ", "rb").read().split(b"\0")
        except OSError:
            continue
        for e in env:
            if e.startswith(b"DISPLAY="):
                return e[8:].decode()
    return ":0"


def nudge_steam() -> None:
    import ctypes
    try:
        x11 = ctypes.CDLL("libX11.so.6")
        xtst = ctypes.CDLL("libXtst.so.6")
    except OSError as err:
        log(f"idle nudge: {err}")
        return
    x11.XOpenDisplay.restype = ctypes.c_void_p
    x11.XOpenDisplay.argtypes = [ctypes.c_char_p]
    x11.XKeysymToKeycode.argtypes = [ctypes.c_void_p, ctypes.c_ulong]
    x11.XFlush.argtypes = x11.XCloseDisplay.argtypes = [ctypes.c_void_p]
    xtst.XTestFakeKeyEvent.argtypes = [ctypes.c_void_p, ctypes.c_uint, ctypes.c_int, ctypes.c_ulong]
    dpy = x11.XOpenDisplay(steam_display().encode())
    if not dpy:
        return
    try:
        code = x11.XKeysymToKeycode(dpy, XK_SHIFT_R)
        if code:
            xtst.XTestFakeKeyEvent(dpy, code, 1, 0)
            xtst.XTestFakeKeyEvent(dpy, code, 0, 0)
            x11.XFlush(dpy)
    finally:
        x11.XCloseDisplay(dpy)


def watch_touch_activity() -> None:
    import select
    fds: dict[int, str] = {}
    last_nudge = -NUDGE_S
    while True:
        if not fds:
            for node in touch_event_nodes():
                try:
                    fds[os.open(node, os.O_RDONLY | os.O_NONBLOCK)] = node
                except OSError:
                    pass
            if not fds:
                time.sleep(10)
                continue
            log(f"idle nudge: watching {', '.join(fds.values())}")
        touched = False
        for fd in select.select(list(fds), [], [], 5.0)[0]:
            try:
                data = os.read(fd, EVENT_SIZE * 64)
            except BlockingIOError:
                continue
            except OSError:
                os.close(fd)
                del fds[fd]
                continue
            # type is the u16 right after the 16-byte timestamp
            touched = touched or any(
                int.from_bytes(data[o + 16:o + 18], sys.byteorder) in (EV_KEY, EV_ABS)
                for o in range(0, len(data) - EVENT_SIZE + 1, EVENT_SIZE))
        global last_touch
        if touched:
            last_touch = time.monotonic()
        if touched and time.monotonic() - last_nudge >= NUDGE_S:
            last_nudge = time.monotonic()
            try:
                nudge_steam()
            except Exception as err:  # never take the dashboard down for this
                log(f"idle nudge failed: {err}")


# ------------------------------------------------------- top screen input ----
# The Trackpad and Keyboard pages drive the TOP screen: a virtual mouse and
# keyboard (uinput, open to the seat's user). The bottom gamescope only takes
# the devices in GAMESCOPE_INPUT_ONLY, so only the top screen's gamescope (and
# through it Steam or the game) sees them; in Desktop Mode KWin does.
UI_SET_EVBIT, UI_SET_KEYBIT, UI_SET_RELBIT = 0x40045564, 0x40045565, 0x40045566
UI_DEV_SETUP, UI_DEV_CREATE = 0x405C5503, 0x5501
EV_SYN, EV_REL = 0, 2
REL_X, REL_Y, REL_HWHEEL, REL_WHEEL = 0, 1, 6, 8
BUTTONS = {"left": 0x110, "right": 0x111, "middle": 0x112}
KEY_LEFTSHIFT = 42
NAMED_KEYS = {"BackSpace": 14, "Return": 28, "Tab": 15, "Escape": 1,
              "Left": 105, "Right": 106, "Up": 103, "Down": 108,
              "Delete": 111, "Home": 102, "End": 107, "Prior": 104, "Next": 109,
              "Menu": 127}
MOD_KEYS = {"ctrl": 29, "alt": 56, "super": 125, "shift": 42}
# US layout: character -> (key code, shift)
US_KEYS: dict[str, tuple[int, bool]] = {" ": (57, False)}
for _row, _base in (("1234567890", 2), ("qwertyuiop", 16), ("asdfghjkl", 30), ("zxcvbnm", 44)):
    for _i, _c in enumerate(_row):
        US_KEYS[_c] = (_base + _i, False)
        if _c.isalpha():
            US_KEYS[_c.upper()] = (_base + _i, True)
for _c, _k in zip("!@#$%^&*()", range(2, 12)):
    US_KEYS[_c] = (_k, True)
for _plain, _shifted, _k in (("-", "_", 12), ("=", "+", 13), ("[", "{", 26), ("]", "}", 27),
                             (";", ":", 39), ("'", '"', 40), ("`", "~", 41), ("\\", "|", 43),
                             (",", "<", 51), (".", ">", 52), ("/", "?", 53)):
    US_KEYS[_plain], US_KEYS[_shifted] = (_k, False), (_k, True)


class UInputDevice:
    def __init__(self, name: str, keys: list[int], rels: list[int], product: int):
        import fcntl
        self.fd = os.open("/dev/uinput", os.O_WRONLY | os.O_NONBLOCK)
        if keys:
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
            for k in keys:
                fcntl.ioctl(self.fd, UI_SET_KEYBIT, k)
        if rels:
            fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_REL)
            for r in rels:
                fcntl.ioctl(self.fd, UI_SET_RELBIT, r)
        setup = struct.pack("HHHH80sI", 0x06, 0x1d6b, product, 1, name.encode()[:79], 0)
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)

    def emit(self, events: list[tuple[int, int, int]]) -> None:
        data = b"".join(struct.pack("qqHHi", 0, 0, t, c, v) for t, c, v in events)
        os.write(self.fd, data + struct.pack("qqHHi", 0, 0, EV_SYN, 0, 0))


class RemoteInput:
    """Made on first use, so nothing appears until the pages are used."""
    def __init__(self):
        self.lock = threading.Lock()
        self.mouse: UInputDevice | None = None
        self.keys: UInputDevice | None = None
        self.scroll_rest = [0.0, 0.0]

    def _devices(self) -> bool:
        if self.mouse and self.keys:
            return True
        try:
            self.mouse = UInputDevice("SteamOS Bottom Screen Trackpad", list(BUTTONS.values()),
                                      [REL_X, REL_Y, REL_WHEEL, REL_HWHEEL], 0x5301)
            self.keys = UInputDevice("SteamOS Bottom Screen Keys",
                                     sorted({k for k, _ in US_KEYS.values()} | set(NAMED_KEYS.values())
                                            | set(MOD_KEYS.values())), [], 0x5302)
            return True
        except OSError as exc:
            log(f"top-screen input: {exc}")
            self.mouse = self.keys = None
            return False

    def move(self, dx: int, dy: int) -> bool:
        with self.lock:
            if not self._devices():
                return False
            self.mouse.emit([(EV_REL, REL_X, max(-2000, min(2000, dx))),
                             (EV_REL, REL_Y, max(-2000, min(2000, dy)))])
            return True

    def scroll(self, dx: int, dy: int) -> bool:
        with self.lock:
            if not self._devices():
                return False
            ev = []
            if dy:
                ev.append((EV_REL, REL_WHEEL, -max(-20, min(20, dy))))   # finger down = scroll up
            if dx:
                ev.append((EV_REL, REL_HWHEEL, max(-20, min(20, dx))))
            if ev:
                self.mouse.emit(ev)
            return True

    def button(self, name: str, state: str) -> bool:
        code = BUTTONS.get(name)
        if code is None:
            return False
        with self.lock:
            if not self._devices():
                return False
            if state in ("down", "click"):
                self.mouse.emit([(EV_KEY, code, 1)])
            if state in ("up", "click"):
                self.mouse.emit([(EV_KEY, code, 0)])
            return True

    def release(self) -> None:
        """Let go of every button and modifier (the page went away)."""
        with self.lock:
            if not (self.mouse and self.keys):
                return
            self.mouse.emit([(EV_KEY, c, 0) for c in BUTTONS.values()])
            self.keys.emit([(EV_KEY, c, 0) for c in MOD_KEYS.values()])

    def chord(self, parts) -> bool:
        """["ctrl", "c"], ["ctrl", "alt", "Delete"]...: modifiers, then the
        last part as a character (US layout) or a key name."""
        parts = [str(p) for p in (parts or [])][:6]
        if not parts:
            return False
        mods = [MOD_KEYS[m] for m in parts[:-1] if m in MOD_KEYS]
        last = parts[-1]
        if last in NAMED_KEYS:
            k, shift = NAMED_KEYS[last], False
        elif last in US_KEYS:
            k, shift = US_KEYS[last]
        else:
            return False
        if shift and KEY_LEFTSHIFT not in mods:
            mods.append(KEY_LEFTSHIFT)
        with self.lock:
            if not self._devices():
                return False
            for m in mods:
                self.keys.emit([(EV_KEY, m, 1)])
            self.keys.emit([(EV_KEY, k, 1)])
            self.keys.emit([(EV_KEY, k, 0)])
            for m in reversed(mods):
                self.keys.emit([(EV_KEY, m, 0)])
        return True

    def retype(self, erase: int, chars: str) -> bool:
        for _ in range(max(0, min(64, int(erase)))):
            self.key(None, "BackSpace")
        return self.key(chars, None) if chars else True

    def key(self, text, name) -> bool:
        with self.lock:
            if not self._devices():
                return False
            if name in NAMED_KEYS:
                k = NAMED_KEYS[name]
                self.keys.emit([(EV_KEY, k, 1)])
                self.keys.emit([(EV_KEY, k, 0)])
                return True
            for ch in str(text or "")[:200]:
                if ch not in US_KEYS:
                    continue
                k, shift = US_KEYS[ch]
                if shift:
                    self.keys.emit([(EV_KEY, KEY_LEFTSHIFT, 1)])
                self.keys.emit([(EV_KEY, k, 1)])
                self.keys.emit([(EV_KEY, k, 0)])
                if shift:
                    self.keys.emit([(EV_KEY, KEY_LEFTSHIFT, 0)])
            return True


