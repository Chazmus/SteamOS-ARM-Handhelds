def _panel_rates() -> list[int]:
    """Refresh rates of the Game Mode (top) panel, from panel-modes."""
    try:
        out = json.loads(run("/usr/lib/steamos/panel-modes", "--json", timeout=5) or "[]")
    except ValueError:
        return []
    bottom = {os.environ.get("BOTTOM_CONNECTOR", "")}
    best: list[int] = []
    for c in out if isinstance(out, list) else []:
        if c.get("name") in bottom:
            continue
        rates = sorted({int(r) for r in c.get("rates", []) if int(r) >= 30})
        if len(rates) > len(best):
            best = rates
    return best


PANEL_RATES: list[int] | None = None


def refresh_state() -> dict | None:
    """The refresh rate games get on the top screen: Steam's own refresh
    slider sets GAMESCOPE_DYNAMIC_REFRESH on its display, so this reads and
    sets the same thing (and Steam changes it again for a game with its own
    setting). choice 0: none made, games get the panel's highest."""
    global PANEL_RATES
    if PANEL_RATES is None:
        PANEL_RATES = _panel_rates()
    if len(PANEL_RATES) < 2:
        return None
    m = re.search(r"= (\d+)", run("env", f"DISPLAY={steam_display()}", "xprop", "-root",
                                  "GAMESCOPE_DYNAMIC_REFRESH"))
    choice = int(m.group(1)) if m else 0
    return {"rates": PANEL_RATES, "choice": choice if choice in PANEL_RATES else 0}


def set_refresh(hz: int) -> bool:
    st = refresh_state()
    if not st:
        return False
    disp = f"DISPLAY={steam_display()}"
    if hz in st["rates"]:
        run("env", disp, "xprop", "-root", "-f", "GAMESCOPE_DYNAMIC_REFRESH", "32c",
            "-set", "GAMESCOPE_DYNAMIC_REFRESH", str(hz))
    elif hz == 0:
        run("env", disp, "xprop", "-root", "-remove", "GAMESCOPE_DYNAMIC_REFRESH")
    else:
        return False
    return True


