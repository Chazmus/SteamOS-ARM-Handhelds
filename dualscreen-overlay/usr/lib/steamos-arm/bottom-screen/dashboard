class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_):
        pass

    def reply(self, obj, code: int = 200) -> None:
        data = json.dumps(obj).encode()
        try:
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass                    # the UI went away mid-request (restart/quit)

    def authorised(self) -> bool:
        if self.headers.get("X-Token") != TOKEN:
            self.reply({"error": "forbidden"}, 403)
            return False
        return True

    def body(self) -> dict:
        n = int(self.headers.get("Content-Length", "0") or 0)
        try:
            return json.loads(self.rfile.read(n) or b"{}") if n else {}
        except ValueError:
            return {}

    def do_GET(self):
        if not self.authorised():
            return
        if self.path == "/state":
            cfg = load_config()
            apps = {a["id"]: a for a in list_apps()}
            self.reply({
                "model": MODEL,
                "time": time.strftime("%H:%M"),
                "battery": battery(),
                "temps": temperatures(),
                "fan": fan_percent(),
                "cpu": cpu(),
                "gpu": gpu(),
                "fps": FPS.get(),
                "power_w": power_watts(),
                "memory": memory(),
                **konkrd_state(),
                "backlights": backlights(),
                "dual": dual_backlight(),
                "rgb": rgb_state(),
                "volume": volume(),
                "pinned": [{k: apps[i][k] for k in ("id", "name", "icon")} for i in cfg["pinned"] if i in apps],
                "running": [{"id": i, "name": apps[i]["name"], "icon": apps[i]["icon"]}
                            for i in APPS.running() if i in apps],
                "show_stats": cfg.get("show_stats", True),
            })
        elif self.path == "/keyboard":
            self.reply(KEYBOARD.state())
        elif self.path == "/apps":
            pinned = set(load_config()["pinned"])
            self.reply([{"id": a["id"], "name": a["name"], "icon": a["icon"], "pinned": a["id"] in pinned}
                        for a in list_apps()])
        else:
            self.reply({"error": "not found"}, 404)

    def do_POST(self):
        if not self.authorised():
            return
        b, ok = self.body(), True
        path = self.path.strip("/").split("/")
        if path[0] == "steam" and len(path) == 2:
            ok = steam_button(path[1])
        elif path[0] == "konkrd" and len(path) == 2:
            ok = konkrd(path[1])
        elif path == ["brightness"]:
            if any(k in b for k in ("level", "bottom_share", "bottom_on")):
                req = {"op": "set", **{k: b[k] for k in ("level", "bottom_share", "bottom_on") if k in b}}
                ok = dual_backlight(req) is not None
            else:
                ok = set_brightness(str(b.get("id", "")), int(b.get("percent", 50)))
        elif path == ["rgb"]:
            ok = set_rgb(b)
        elif path == ["pointer"]:
            ok = TOP_INPUT.move(int(b.get("dx", 0)), int(b.get("dy", 0)))
        elif path == ["scroll"]:
            ok = TOP_INPUT.scroll(int(b.get("dx", 0)), int(b.get("dy", 0)))
        elif path == ["button"]:
            ok = TOP_INPUT.button(str(b.get("button", "left")), str(b.get("state", "click")))
        elif path == ["key"]:
            ok = TOP_INPUT.key(b.get("text"), b.get("key"))
        elif path == ["type"]:
            ok = TYPER.type(b.get("text"), b.get("key"))
        elif path == ["keyboard"]:
            KEYBOARD.set(bool(b.get("visible")), b.get("top"))
        elif path == ["volume"]:
            set_volume(b.get("percent"), b.get("mute"))
        elif path == ["launch"]:
            ok = APPS.launch(str(b.get("id", "")))
        elif path == ["focus"]:
            ok = focus_app(str(b.get("id", "")), APPS)
        elif path == ["close"]:
            ok = APPS.close(str(b.get("id", "")))
        elif path == ["home"]:
            show_dashboard()
        elif path == ["pin"]:
            cfg = load_config()
            app_id = str(b.get("id", ""))
            pinned = [p for p in cfg["pinned"] if p != app_id]
            if b.get("pinned") and app_by_id(app_id):
                pinned.append(app_id)
            cfg["pinned"] = pinned
            save_config(cfg)
        elif path == ["settings"]:
            cfg = load_config()
            if "show_stats" in b:
                cfg["show_stats"] = bool(b["show_stats"])
            save_config(cfg)
        else:
            self.reply({"error": "not found"}, 404)
            return
        self.reply({"ok": bool(ok)})


def main() -> int:
    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    port = server.server_address[1]
    threading.Thread(target=server.serve_forever, daemon=True).start()
    threading.Thread(target=watch_home_gesture, daemon=True).start()
    threading.Thread(target=watch_touch_activity, daemon=True).start()
    log(f"api on 127.0.0.1:{port}, model {MODEL!r}")
    # The UI reads the API address + token from a private file (argv and the
    # environment are readable by other users through /proc).
    api_file = RUNTIME / "bottom-screen.api"
    fd = os.open(api_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump({"url": f"http://127.0.0.1:{port}", "token": TOKEN}, fh)
    # KDE platform theme: Breeze icons for the buttons and apps. EGL straight
    # on the GPU: through GLX the UI ended up on zink with gamescope's WSI
    # layer in between, which recreated its swapchains and stuttered.
    env = dict(os.environ, QT_QPA_PLATFORM="xcb", QT_XCB_GL_INTEGRATION="xcb_egl",
               DISABLE_GAMESCOPE_WSI="1", QT_QUICK_CONTROLS_MOBILE="1",
               QML_XHR_ALLOW_FILE_READ="1", QT_QPA_PLATFORMTHEME="kde",
               XDG_CURRENT_DESKTOP="KDE")
    env.pop("WAYLAND_DISPLAY", None)

    def keep_running(qml: Path, name: str, after_start=None) -> None:
        while True:
            started = time.monotonic()
            proc = subprocess.Popen(["qml6", str(qml), "--", str(api_file)], env=env)
            if after_start:
                threading.Thread(target=after_start, daemon=True).start()
            rc = proc.wait()
            if time.monotonic() - started < 3:
                log(f"{name} exited right away ({rc}), retrying in 5 s")
                time.sleep(5)

    # The keyboard first, so it is an overlay before the dashboard maps.
    threading.Thread(target=keep_running, args=(QML.parent / "Keyboard.qml", "keyboard", KEYBOARD.adopt),
                     daemon=True).start()
    threading.Thread(target=watch_text_focus, daemon=True).start()
    time.sleep(1)
    keep_running(QML, "UI")


if __name__ == "__main__":
    sys.exit(main())
