            save_config(cfg)
        else:
            self.reply({"error": "not found"}, 404)
            return
        self.reply({"ok": bool(ok)})


def main() -> int:
    server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
    port = server.server_address[1]
    threading.Thread(target=server.serve_forever, daemon=True).start()
    threading.Thread(target=watch_home_gesture, daemon=True).start()
    threading.Thread(target=watch_touch_activity, daemon=True).start()
    threading.Thread(target=GAMES.watch, daemon=True).start()
    log(f"api on 127.0.0.1:{port}, model {MODEL!r}")
    # The UI reads the API address + token from a private file (argv and the
    # environment are readable by other users through /proc).
    api_file = RUNTIME / "bottom-screen.api"
    fd = os.open(api_file, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump({"url": f"http://127.0.0.1:{port}", "token": TOKEN}, fh)
    # KDE platform theme: Breeze icons for the buttons and apps. EGL straight
    # on the GPU: through GLX the UI ended up on zink with gamescope's WSI
    # layer in between, which recreated its swapchains and stuttered.
    env = dict(os.environ, QT_QPA_PLATFORM="xcb", QT_XCB_GL_INTEGRATION="xcb_egl",
               DISABLE_GAMESCOPE_WSI="1", QT_QUICK_CONTROLS_MOBILE="1",
               QML_XHR_ALLOW_FILE_READ="1", QT_QPA_PLATFORMTHEME="kde",
               XDG_CURRENT_DESKTOP="KDE")
    env.pop("WAYLAND_DISPLAY", None)

    def keep_running(qml: Path, name: str, after_start=None) -> None:
        while True:
            started = time.monotonic()
            proc = subprocess.Popen(["qml6", str(qml), "--", str(api_file)], env=env)
            if after_start:
                threading.Thread(target=after_start, daemon=True).start()
            rc = proc.wait()
            if time.monotonic() - started < 3:
                log(f"{name} exited right away ({rc}), retrying in 5 s")
                time.sleep(5)

    # The keyboard first, so it is an overlay before the dashboard maps.
    threading.Thread(target=keep_running, args=(QML.parent / "Keyboard.qml", "keyboard", KEYBOARD.adopt),
                     daemon=True).start()
    threading.Thread(target=watch_text_focus, daemon=True).start()
    time.sleep(1)
    keep_running(QML, "UI")


if __name__ == "__main__":
    sys.exit(main())
