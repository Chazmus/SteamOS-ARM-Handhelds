                "dual": dual_backlight(),
                "rgb": rgb_state(),
                "volume": volume(),
                "pinned": [{k: apps[i][k] for k in ("id", "name", "icon")} for i in cfg["pinned"] if i in apps],
                "running": [{"id": i, "name": apps[i]["name"], "icon": apps[i]["icon"]}
                            for i in APPS.running() if i in apps],
                "net": NET.get(),
