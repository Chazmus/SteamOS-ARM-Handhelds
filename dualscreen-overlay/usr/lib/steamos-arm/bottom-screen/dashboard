STEAM_HOME = Path.home() / ".local/share/Steam"
NOT_GAMES = {0, 769}       # nothing, Steam's own UI


def _library_dirs() -> list[Path]:
    out = [STEAM_HOME / "steamapps"]
    vdf = STEAM_HOME / "steamapps" / "libraryfolders.vdf"
    for m in re.finditer(r'"path"\s+"([^"]+)"', rd(str(vdf))):
        d = Path(m.group(1)) / "steamapps"
        if d not in out:
            out.append(d)
    return out


class Games:
    """The game in front on the top screen (gamescope's GAMESCOPE_FOCUSED_APP
    on Steam's display) and its name from Steam's app manifests. Also applies
    per-game settings: when a game with remembered settings comes to the
    front, its profile, fan and refresh rate are set, and what was there
    before goes back when it leaves."""

    def __init__(self):
        self.lock = threading.Lock()
        self.appid = 0
        self.names: dict[int, str] = {}
        self.before: dict | None = None     # settings to restore after a game

    def name(self, appid: int) -> str:
        if appid in self.names:
            return self.names[appid]
        name = ""
        for d in _library_dirs():
            m = re.search(r'"name"\s+"([^"]+)"', rd(str(d / f"appmanifest_{appid}.acf")))
            if m:
                name = m.group(1)
                break
        self.names[appid] = name
        return name

    def poll(self) -> int:
        m = re.search(r"= (\d+)", run("env", f"DISPLAY={steam_display()}", "xprop", "-root",
                                      "GAMESCOPE_FOCUSED_APP"))
        appid = int(m.group(1)) if m else 0
        return 0 if appid in NOT_GAMES else appid

    def state(self, cfg: dict) -> dict:
        with self.lock:
            appid = self.appid
        return {"appid": appid, "name": self.name(appid) if appid else "",
                "remembered": str(appid) in cfg.get("per_game", {})}

    @staticmethod
    def current_settings() -> dict:
        k = konkrd_state()
        r = refresh_state()
        return {"profile": k["profile"], "fan_mode": k["fan_mode"], "fan_fixed": k["fan_fixed"],
                "refresh": r["choice"] if r else 0}

    @staticmethod
    def apply(st: dict) -> None:
        if st.get("profile") in ("silent", "balanced", "turbo"):
            konkrd(f"profile-{st['profile']}")
        mode = st.get("fan_mode")
        if mode == "boost":
            konkrd("fan-boost-on")
        elif mode == "fixed":
            konkrd(f"fan-fixed:{int(st.get('fan_fixed', 50))}")
        elif mode == "auto":
            konkrd("fan-auto")
        if "refresh" in st:
            set_refresh(int(st["refresh"] or 0))

    def remember(self, on: bool) -> bool:
        with self.lock:
            appid = self.appid
        if not appid:
            return False
        cfg = load_config()
        per = dict(cfg.get("per_game", {}))
        if on:
            per[str(appid)] = self.current_settings()
        else:
            per.pop(str(appid), None)
        cfg["per_game"] = per
        save_config(cfg)
        return True

    def watch(self) -> None:
        while True:
            time.sleep(3)
            try:
                appid = self.poll()
            except Exception:
                continue
            with self.lock:
                if appid == self.appid:
                    continue
                left, self.appid = self.appid, appid
            per = load_config().get("per_game", {})
            if appid and str(appid) in per:
                if self.before is None:
                    self.before = self.current_settings()
                log(f"game {appid}: its remembered settings")
                self.apply(per[str(appid)])
            elif left and self.before is not None and not (appid and str(appid) in per):
                log("game left: settings from before it")
                self.apply(self.before)
                self.before = None


