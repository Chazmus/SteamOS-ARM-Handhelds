class Handler(BaseHTTPRequestHandler):
    def log_message(self, *_):
        pass

    def reply(self, obj, code: int = 200) -> None:
        data = json.dumps(obj).encode()
        try:
            self.send_response(code)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)
        except (BrokenPipeError, ConnectionResetError):
            pass                    # the UI went away mid-request (restart/quit)

    def authorised(self) -> bool:
        if self.headers.get("X-Token") != TOKEN:
            self.reply({"error": "forbidden"}, 403)
            return False
        return True

    def body(self) -> dict:
        n = int(self.headers.get("Content-Length", "0") or 0)
        try:
            return json.loads(self.rfile.read(n) or b"{}") if n else {}
        except ValueError:
            return {}

    def do_GET(self):
        if not self.authorised():
            return
        if self.path == "/state":
            cfg = load_config()
            apps = {a["id"]: a for a in list_apps() + web_entries(cfg)}
            rows = {
                "pinned": [{k: apps[i][k] for k in ("id", "name", "icon")} for i in cfg["pinned"] if i in apps],
                "running": [{"id": i, "name": apps[i]["name"], "icon": apps[i]["icon"]}
                            for i in APPS.running() if i in apps],
            }
            if not rows["running"]:
                DASHBOARD_SHOWN.set()       # last app gone: gamescope shows us again
                if NAV.state()["front"]:
                    NAV.show("home")
            rows["nav"] = NAV.state()
            if not DASHBOARD_SHOWN.is_set():
                self.reply({"hidden": True, **rows})
                return
            self.reply({
                "model": MODEL,
                "time": time.strftime("%H:%M"),
                "battery": battery(),
                "temps": temperatures(),
                "fan": fan_percent(),
                "cpu": cpu(),
                "gpu": gpu(),
