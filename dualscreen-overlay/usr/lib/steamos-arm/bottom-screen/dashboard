class NetSpeed:
    """Download/upload over Wi-Fi and Ethernet in bytes/s since the last call."""
    def __init__(self):
        self.prev = (0, 0, time.monotonic())
        self.get()

    def get(self) -> dict:
        rx = tx = 0
        for line in rd("/proc/net/dev").splitlines()[2:]:
            name, _, data = line.partition(":")
            if name.strip().startswith(("lo", "docker", "veth", "virbr")):
                continue
            f = data.split()
            if len(f) >= 9:
                rx, tx = rx + int(f[0]), tx + int(f[8])
        now = time.monotonic()
        prx, ptx, pt = self.prev
        self.prev = (rx, tx, now)
        dt = max(now - pt, 0.1)
        return {"down": max(0, round((rx - prx) / dt)), "up": max(0, round((tx - ptx) / dt))}


