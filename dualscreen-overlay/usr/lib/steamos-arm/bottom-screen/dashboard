def backlights() -> list[dict]:
    names = BACKLIGHT_NAMES.get(MODEL, {})
    out = []
    for d in sorted(glob.glob("/sys/class/backlight/*")):
        name = os.path.basename(d)
        try:
            cur, mx = int(rd(f"{d}/brightness", "0")), int(rd(f"{d}/max_brightness", "1"))
        except ValueError:
            continue
        out.append({"id": name, "label": names.get(name, name),
                    "percent": round(cur * 100 / max(mx, 1))})
    out.sort(key=lambda b: (b["label"] != "Top screen", b["label"]))
    return out


def session_path() -> str | None:
    sid = run("loginctl", "show-seat", "seat0", "-p", "ActiveSession", "--value").strip()
    if not sid:
        return None
    m = re.search(r'"(/org/freedesktop/login1/session/[^"]+)"',
                  run("busctl", "call", "org.freedesktop.login1", "/org/freedesktop/login1",
                      "org.freedesktop.login1.Manager", "GetSession", "s", sid))
    return m.group(1) if m else None


def set_brightness(name: str, percent: int) -> bool:
    d = f"/sys/class/backlight/{name}"
    if not os.path.isdir(d) or "/" in name:
        return False
    try:
        mx = int(rd(f"{d}/max_brightness", "0"))
    except ValueError:
        return False
    value = max(1, round(mx * max(1, min(100, percent)) / 100))
    path = session_path()
    if not path:
        return False
    run("busctl", "call", "org.freedesktop.login1", path, "org.freedesktop.login1.Session",
        "SetBrightness", "ssu", "backlight", name, str(value))
    return True


THOR_BACKLIGHT_SOCK = "/run/steamos-arm/thor-backlight.sock"


def dual_backlight(req: dict | None = None) -> dict | None:
    """thor-backlightd: Steam's level for both Thor screens, the bottom
    screen's share of it, and the bottom screen on/off. None elsewhere."""
    if not os.path.exists(THOR_BACKLIGHT_SOCK):
        return None
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(2)
            sock.connect(THOR_BACKLIGHT_SOCK)
            sock.sendall(json.dumps(req or {"op": "get"}).encode() + b"\n")
            data = b""
            while not data.endswith(b"\n"):
                chunk = sock.recv(4096)
                if not chunk:
                    break
                data += chunk
        reply = json.loads(data or b"{}")
        return None if "error" in reply else reply
    except (OSError, ValueError):
        return None


def stick_leds() -> bool:
    """Same LEDs konkrd drives (see stick_leds() there)."""
    return bool(glob.glob("/sys/class/leds/*joysticks*") or glob.glob("/sys/class/leds/rgb:[lr][0-9]")
                or glob.glob("/sys/class/leds/*-joystick"))


def rgb_state() -> dict | None:
    if not stick_leds():
        return None
    try:
        rgb = json.loads(rd(KONKRD_STATE, "{}")).get("rgb", {})
    except ValueError:
        rgb = {}
    return {"mode": rgb.get("mode", "static"), "color": str(rgb.get("color", "ff3c00")).lower(),
            "brightness": int(rgb.get("brightness", 160))}


def set_rgb(b: dict) -> bool:
    cur = rgb_state()
    if cur is None:
        return False
    mode = str(b.get("mode", cur["mode"]))
    color = str(b.get("color", cur["color"])).lower()
    try:
        bri = max(0, min(255, int(b.get("brightness", cur["brightness"]))))
    except (TypeError, ValueError):
        return False
    if mode not in ("static", "breath", "off") or not re.fullmatch(r"[0-9a-f]{6}", color):
        return False
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as sock:
            sock.sendto(f"rgb-set:{mode}:{color}:{bri}".encode(), KONKRD_SOCK)
        return True
    except OSError as exc:
        log(f"konkrd: {exc}")
        return False


