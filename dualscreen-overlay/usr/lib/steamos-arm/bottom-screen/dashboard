def temperatures() -> dict:
    cpu = gpu = hot = 0.0
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t = rd(f"{z}/type")
        try:
            v = int(rd(f"{z}/temp", "0")) / 1000.0
        except ValueError:
            continue
        if v > 150:                  # unpopulated sensors read nonsense
            continue
        if t.startswith("cpu"):
            cpu = max(cpu, v)
        elif t.startswith("gpu") or "gpuss" in t:
            gpu = max(gpu, v)
        if t.startswith(("cpu", "gpu", "aoss", "mdmss", "nsp", "video", "camera", "ddr")):
            hot = max(hot, v)
    return {"cpu": round(cpu), "gpu": round(gpu), "hot": round(max(hot, cpu, gpu))}


def fan_percent() -> int:
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        if rd(f"{d}/name") == "pwmfan":
            try:
                return round(int(rd(f"{d}/pwm1", "0")) * 100 / 255)
            except ValueError:
                return -1
    return -1


def gpu() -> dict:
    for d in glob.glob("/sys/class/devfreq/*"):
        if "gpu" in os.path.basename(d) or "3d00000" in d:
            try:
                return {"mhz": int(rd(f"{d}/cur_freq", "0")) // 1_000_000,
                        "max_mhz": int(rd(f"{d}/max_freq", "0")) // 1_000_000}
            except ValueError:
                break
    return {"mhz": 0, "max_mhz": 0}


