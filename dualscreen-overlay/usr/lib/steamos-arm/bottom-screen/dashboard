def battery() -> dict:
    for b in glob.glob("/sys/class/power_supply/*"):
        if rd(f"{b}/type") != "Battery":
            continue
        try:
            out = {"percent": int(rd(f"{b}/capacity", "0")), "status": rd(f"{b}/status")}
        except ValueError:
            continue
        # Time left at the current draw (energy, or charge x voltage).
        try:
            uv, ua = int(rd(f"{b}/voltage_now")), abs(int(rd(f"{b}/current_now")))
            if rd(f"{b}/energy_now"):
                wh = int(rd(f"{b}/energy_now")) / 1e6
            else:
                wh = int(rd(f"{b}/charge_now")) / 1e6 * uv / 1e6
            w = uv * ua / 1e12
            if out["status"] == "Discharging" and w > 0.3:
                out["hours_left"] = round(wh / w, 2)
        except ValueError:
            pass
        return out
    return {"percent": -1, "status": ""}


class CpuLoad:
    """Busy share of all CPUs since the last call (/proc/stat)."""
    def __init__(self):
        self.prev = self.sample()

    @staticmethod
    def sample() -> tuple[int, int]:
        f = rd("/proc/stat").split("\n", 1)[0].split()[1:]
        try:
            v = [int(x) for x in f]
        except ValueError:
            return 0, 0
        idle = v[3] + (v[4] if len(v) > 4 else 0)
        return sum(v), idle

    def get(self) -> int:
        cur = self.sample()
        total, idle = cur[0] - self.prev[0], cur[1] - self.prev[1]
        self.prev = cur
        return round(100 * (total - idle) / total) if total > 0 else 0


CPU_LOAD = CpuLoad()


def cpu() -> dict:
    """Load, and the fastest cluster's clock (what a game runs on)."""
    ghz = 0.0
    for pol in glob.glob("/sys/devices/system/cpu/cpufreq/policy*"):
        try:
            ghz = max(ghz, int(rd(f"{pol}/scaling_cur_freq", "0")) / 1e6)
        except ValueError:
            pass
    return {"ghz": round(ghz, 2), "load": CPU_LOAD.get()}


def power_watts() -> float | None:
    """Battery draw in W (voltage x current), None when unknown."""
    for b in glob.glob("/sys/class/power_supply/*"):
        if rd(f"{b}/type") == "Battery":
            try:
                w = int(rd(f"{b}/voltage_now")) * int(rd(f"{b}/current_now")) / 1e12
            except ValueError:
                return None
            return round(abs(w), 1)
    return None


def memory() -> dict:
    info = {}
    for line in rd("/proc/meminfo").splitlines():
        k, _, v = line.partition(":")
        if v.split():
            info[k] = int(v.split()[0])
    total = info.get("MemTotal", 0)
    used = total - info.get("MemAvailable", total)
    return {"used_gb": round(used / 1048576, 1), "total_gb": round(total / 1048576, 1)}


class FpsReader:
    """Game frame rate from gamescope's stats FIFO ("fps=<float>" lines).
    None once no game has drawn for a few seconds (desktop apps, Steam UI)."""
    def __init__(self):
        self.fps: float | None = None
        self.at = 0.0
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self) -> None:
        link = os.path.join(os.environ.get("XDG_RUNTIME_DIR", f"/run/user/{os.getuid()}"), "gamescope-stats")
        while True:
            try:
                with open(os.path.join(os.path.realpath(link), "stats.pipe")) as pipe:
                    for line in pipe:
                        if line.startswith("fps="):
                            try:
                                self.fps, self.at = float(line[4:]), time.monotonic()
                            except ValueError:
                                pass
            except OSError:
                pass
            time.sleep(2)

    def get(self) -> float | None:
        return round(self.fps) if self.fps is not None and time.monotonic() - self.at < 3 else None


FPS = FpsReader()


def temperatures() -> dict:
    cpu = gpu = hot = 0.0
    for z in glob.glob("/sys/class/thermal/thermal_zone*"):
        t = rd(f"{z}/type")
        try:
            v = int(rd(f"{z}/temp", "0")) / 1000.0
        except ValueError:
            continue
        if v > 150:                  # unpopulated sensors read nonsense
            continue
        if t.startswith("cpu"):
            cpu = max(cpu, v)
        elif t.startswith("gpu") or "gpuss" in t:
            gpu = max(gpu, v)
        if t.startswith(("cpu", "gpu", "aoss", "mdmss", "nsp", "video", "camera", "ddr")):
            hot = max(hot, v)
    return {"cpu": round(cpu), "gpu": round(gpu), "hot": round(max(hot, cpu, gpu))}


def fan_percent() -> int:
    for d in glob.glob("/sys/class/hwmon/hwmon*"):
        if rd(f"{d}/name") == "pwmfan":
            try:
                return round(int(rd(f"{d}/pwm1", "0")) * 100 / 255)
            except ValueError:
                return -1
    return -1


def gpu() -> dict:
    for d in glob.glob("/sys/class/devfreq/*"):
        if "gpu" in os.path.basename(d) or "3d00000" in d:
            try:
                return {"mhz": int(rd(f"{d}/cur_freq", "0")) // 1_000_000,
                        "max_mhz": int(rd(f"{d}/max_freq", "0")) // 1_000_000}
            except ValueError:
                break
    return {"mhz": 0, "max_mhz": 0}


def konkrd_state() -> dict:
    try:
