/*
 * SteamOS ARM additions for the KONKR Pocket FIT Elite (appended to
 * sm8750-konkr-pf-elite.dts by kernel-common/build.sh). s2idle (as ArmadaOS):
 * the Wi-Fi WAKE# line is active low, read as active high it can wake the SoC
 * straight back up; the codec keeps these rails enabled through the sleep,
 * idle them in LPM.
 */

&pcieport0 {
	wake-gpios = <&tlmm 104 GPIO_ACTIVE_LOW>;
};

&vreg_bob1 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_l15b_1p8 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_l2i_1p2 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_s3g_1p8 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};

&vreg_s7i_1p2 {
	regulator-state-mem {
		regulator-on-in-suspend;
		regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
	};
};
