# SPDX-License-Identifier: MIT
# tb323fu-usb-host.rules -- keep a real USB host from losing the controller.
#
# The one dwc3 is shared by both USB-C connectors (a600000.usb-role-switch).
# ucsi drives the role for port0; if it (or a later Type-C event) drops the
# controller to device while a real host (partner [source] and [host]) is
# plugged in, host-reconcile puts the role back. set_role emits a change even
# for the same value, so the helper never writes a role it already has and its
# own event is a no-op. The 70 partner rule is unchanged.
SUBSYSTEM=="usb_role", KERNEL=="a600000.usb-role-switch", ACTION=="change", RUN+="/usr/libexec/tb323fu/tb323fu-usb-port host-reconcile"
