+    fn process_haptic(&mut self, report: PackedHapticReport) -> Result<(), Box<dyn Error + Send + Sync>> {
+        let Some((value, length)) = haptic_pulse(&report) else {
+            return Ok(());
+        };
+        let pulse = Some(Pulse {
+            level: value,
+            until: Instant::now() + length,
+        });
+        match report.side {
+            PadSide::Left => self.pulses[0] = pulse,
+            PadSide::Right => self.pulses[1] = pulse,
+            PadSide::Both => self.pulses = [pulse, pulse],
+        }
