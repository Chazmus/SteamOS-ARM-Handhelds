+/// A rumble request: from `start`, until `until` (or until replaced/stopped).
+#[derive(Debug, Copy, Clone, PartialEq)]
+struct Rumble {
+    level: Motors,
+    start: Instant,
+    until: Option<Instant>,
+}
+
+/// A short haptic pulse on one motor, laid over any rumble.
+#[derive(Debug, Copy, Clone, PartialEq)]
+struct Pulse {
+    level: u8,
+    until: Instant,
+}
