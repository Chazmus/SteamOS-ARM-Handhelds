 /// Output-only source for the rumble motors exposed by AYANEO DirectInput mode.
 ///
 /// The controller accepts an eight-byte HID output report. Zero-based byte 4
-/// drives the left motor and byte 5 drives the right motor; this layout was
-/// verified against the physical motors on an AYANEO DirectInput controller.
+/// drives the left motor and byte 5 drives the right motor.
+///
+/// The motors only know "spin at this level", so timing lives here: evdev
+/// effects stop after their replay length, and Steam's trackpad haptics (the
+/// clicks and ticks a Steam Deck plays on its pads) become short pulses on
+/// the motor of that side. `poll()` runs every couple of milliseconds and
+/// sends a new report only when the levels change.
 pub struct AyaneoHaptics {
     device: HidDevice,
     ff_evdev_effects: HashMap<i16, FFEffectData>,
+    rumble: Option<Rumble>,
+    pulses: [Option<Pulse>; 2],
+    sent: Motors,
 }
 
+/// High byte of an evdev/Steam 16-bit magnitude, lifted to what the motors feel.
+fn level(magnitude: u16) -> u8 {
+    match (magnitude >> 8) as u8 {
+        0 if magnitude == 0 => 0,
+        v => v.max(MIN_LEVEL),
+    }
+}
+
+/// What the motors should do at `now`.
+fn mix(rumble: Option<&Rumble>, pulses: &[Option<Pulse>; 2], now: Instant) -> Motors {
+    let mut out = match rumble {
+        Some(r) if r.start <= now && r.until.is_none_or(|u| now < u) => r.level,
+        _ => Motors::default(),
+    };
+    if let Some(p) = pulses[0].filter(|p| now < p.until) {
+        out.left = out.left.max(p.level);
+    }
+    if let Some(p) = pulses[1].filter(|p| now < p.until) {
+        out.right = out.right.max(p.level);
+    }
+    out
+}
+
+/// A Steam Deck trackpad haptic command as a motor pulse: level and length.
+fn haptic_pulse(report: &PackedHapticReport) -> Option<(u8, Duration)> {
+    let (base, ms) = match report.cmd_type {
+        CommandType::Off => return None,
+        CommandType::Tick => (0x70_u16, 18_u64),
+        CommandType::Click => (0xb0, 30),
+    };
+    let (stretch, boost) = match report.intensity {
+        Intensity::Default | Intensity::Short => (1.0, 0),
+        Intensity::Medium => (1.5, 0),
+        Intensity::Long => (2.0, 0),
+        Intensity::Insane => (3.0, 0x30),
+    };
+    // Gain is in dB, -24..+6.
+    let gain = 10f32.powf(f32::from(report.gain.clamp(-24, 6)) / 20.0);
+    let value = ((f32::from(base + boost)) * gain).round().clamp(f32::from(MIN_LEVEL), 255.0);
+    Some((value as u8, Duration::from_millis((ms as f64 * stretch) as u64)))
+}
