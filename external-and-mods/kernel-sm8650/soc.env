# SM8650 (Snapdragon 8 Gen 3 / G3 Gen 3): KONKR Pocket FIT, AYANEO Pocket S2.
# Sourced by kernel-common/build.sh and kernel-common/cmdline.sh.

SOC=sm8650
ROCKNIX_DEVICE=SM8650

# ROCKNIX's released recipe (tag 20260801: Linux 7.1.2). Their development
# branch (7.2 + extra power-domain/GPU patches) does not boot on the Pocket
# FIT, black screen before the console (verified on hardware 2026-09-23).
KVER=7.1.2
ROCKNIX_REF=20260801
EXTRA_FW_REF=88b363e67d4f730feb2c3124724d26dfaa88ce76

# ROCKNIX patch dirs in the order this kernel was verified with.
PATCH_DIRS="projects/ROCKNIX/packages/linux/patches/mainline projects/ROCKNIX/devices/SM8650/patches/linux packages/linux/patches/default"

# DTBs appended to KERNEL (ABL shows one menu entry per DTB model).
DTBS="sm8650-ayaneo-ps2 sm8650-konkr-pf"

# Built into the kernel image (needed before the rootfs is mounted):
# <source>:<path under /lib/firmware>. xfw/ = ROCKNIX extra-firmware tree.
BUILTIN_FW="
xfw/SM8650/qcom/gen70900_aqe.fw:qcom/gen70900_aqe.fw
xfw/SM8650/qcom/gen70900_sqe.fw:qcom/gen70900_sqe.fw
xfw/SM8650/qcom/gmu_gen70900.bin:qcom/gmu_gen70900.bin
xfw/SM8650/qcom/sm8650/ayaneo/ps2/gen70900_zap.mbn:qcom/sm8650/ayaneo/ps2/gen70900_zap.mbn
"

# Kernel cmdline, SoC part (see kernel-common/cmdline.sh).
# irqaffinity: IRQs on the two A520s, like ROCKNIX.
# Pocket FIT XInput pad polled at 2 ms (0506-usbcore-add-interrupt-interval-override).
# Deep suspend never resumes on the Pocket FIT (7.1.2); s2idle wakes reliably.
CMDLINE_SOC="irqaffinity=0-1 usbcore.interrupt_interval_override=045e:028e:2 mem_sleep_default=s2idle"
