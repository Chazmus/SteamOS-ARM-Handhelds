#!/usr/bin/env bash
# Retired. This used to force both Thor touchscreens onto DSI-1 / DSI-2 every
# 2 s from a desktop autostart. The kernel's device tree now has the right
# touch setup and KWin maps the two panels by itself, so the loop only fought
# it: touch was fine for a minute in Desktop Mode, then landed on the wrong
# screen. Kept as a no-op because the Thor autoinstall and thorch-display-setup
# still call it.
exit 0
