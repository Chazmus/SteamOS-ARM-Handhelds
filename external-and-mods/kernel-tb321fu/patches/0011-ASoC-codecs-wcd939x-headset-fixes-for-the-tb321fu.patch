From: guf296 <guf296@126.com>
Subject: [PATCH] ASoC: codecs: wcd939x / wcd-mbhc headset fixes for the TB321FU

Headset detection changes from the TB321FU bring-up.

Taken from https://github.com/GUF296/linux branch TB321FU-7.1.1
(5df8e852e), the Lenovo Legion Tab Gen 3 / Y700 2025 (TB321FU) bring-up.
---
diff --git a/sound/soc/codecs/wcd-mbhc-v2.c b/sound/soc/codecs/wcd-mbhc-v2.c
index bb0c8478a..dfdbcb487 100644
--- a/sound/soc/codecs/wcd-mbhc-v2.c
+++ b/sound/soc/codecs/wcd-mbhc-v2.c
@@ -362,7 +362,8 @@ static void wcd_mbhc_report_plug_insertion(struct wcd_mbhc *mbhc,
 
 	if (!is_pa_on) {
 		wcd_mbhc_compute_impedance(mbhc);
-		if ((mbhc->zl > mbhc->cfg->linein_th) &&
+		if (!mbhc->cfg->typec_analog_mux &&
+		    (mbhc->zl > mbhc->cfg->linein_th) &&
 		    (mbhc->zr > mbhc->cfg->linein_th) &&
 		    (jack_type == SND_JACK_HEADPHONE)) {
 			jack_type = SND_JACK_LINEOUT;
@@ -524,7 +525,6 @@ static void mbhc_plug_detect_fn(struct work_struct *work)
 	wcd_mbhc_cancel_pending_work(mbhc);
 
 	detection_type = wcd_mbhc_read_field(mbhc, WCD_MBHC_MECH_DETECTION_TYPE);
-
 	/* Set the detection type appropriately */
 	wcd_mbhc_write_field(mbhc, WCD_MBHC_MECH_DETECTION_TYPE, !detection_type);
 
@@ -617,6 +617,7 @@ int wcd_mbhc_typec_report_plug(struct wcd_mbhc *mbhc)
 	if (mbhc->mbhc_cb->clk_setup)
 		mbhc->mbhc_cb->clk_setup(mbhc->component, true);
 	wcd_mbhc_write_field(mbhc, WCD_MBHC_L_DET_EN, 1);
+	wcd_mbhc_write_field(mbhc, WCD_MBHC_MECH_DETECTION_TYPE, 1);
 
 	schedule_work(&mbhc->mbhc_plug_detect_work);
 
@@ -775,6 +776,15 @@ static int wcd_mbhc_initialise(struct wcd_mbhc *mbhc)
 	else
 		mbhc->swap_thr = GND_MIC_SWAP_THRESHOLD;
 
+	if (mbhc->cfg->typec_analog_mux) {
+		/*
+		 * Lenovo's downstream runtime DT uses active-low MBHC switch
+		 * polarity for the Type-C analog path.
+		 */
+		mbhc->cfg->hphl_swh = false;
+		mbhc->cfg->gnd_swh = false;
+	}
+
 	/* setup HS detection */
 	if (mbhc->mbhc_cb->hph_pull_up_control_v2)
 		mbhc->mbhc_cb->hph_pull_up_control_v2(component,
@@ -1189,7 +1199,6 @@ static void wcd_correct_swch_plug(struct work_struct *work)
 	/* Find plug type */
 	output_mv = wcd_measure_adc_continuous(mbhc);
 	plug_type = wcd_mbhc_get_plug_from_adc(mbhc, output_mv);
-
 	/*
 	 * Report plug type if it is either headset or headphone
 	 * else start the 3 sec loop
diff --git a/sound/soc/codecs/wcd939x.c b/sound/soc/codecs/wcd939x.c
index 01f1a08f4..92605b88c 100644
--- a/sound/soc/codecs/wcd939x.c
+++ b/sound/soc/codecs/wcd939x.c
@@ -671,6 +671,7 @@ static int wcd939x_codec_enable_hphr_pa(struct snd_soc_dapm_widget *w,
 					      WCD939X_VNEG_CTRL_4_ILIM_SEL, 0xd);
 		snd_soc_component_write_field(component, WCD939X_ANA_HPH,
 					      WCD939X_HPH_HPHR_REF_ENABLE, true);
+		wcd_clsh_set_hph_mode(wcd939x->clsh_info, hph_mode);
 
 		if (snd_soc_component_read_field(component, WCD939X_ANA_HPH,
 						 WCD939X_HPH_HPHL_REF_ENABLE))
@@ -794,6 +795,7 @@ static int wcd939x_codec_enable_hphl_pa(struct snd_soc_dapm_widget *w,
 					      WCD939X_VNEG_CTRL_4_ILIM_SEL, 0xd);
 		snd_soc_component_write_field(component, WCD939X_ANA_HPH,
 					      WCD939X_HPH_HPHL_REF_ENABLE, true);
+		wcd_clsh_set_hph_mode(wcd939x->clsh_info, hph_mode);
 
 		if (snd_soc_component_read_field(component, WCD939X_ANA_HPH,
 						 WCD939X_HPH_HPHR_REF_ENABLE))
@@ -2974,10 +2976,10 @@ static int wcd939x_soc_codec_probe(struct snd_soc_component *component)
 	int ret, i;
 
 	time_left = wait_for_completion_timeout(&tx_sdw_dev->initialization_complete,
-						msecs_to_jiffies(2000));
+						msecs_to_jiffies(10000));
 	if (!time_left) {
-		dev_err(dev, "soundwire device init timeout\n");
-		return -ETIMEDOUT;
+		dev_err(dev, "soundwire device init timeout, deferring probe\n");
+		return -EPROBE_DEFER;
 	}
 
 	snd_soc_component_init_regmap(component, wcd939x->regmap);
@@ -3105,8 +3107,20 @@ static int wcd939x_codec_set_jack(struct snd_soc_component *comp,
 {
 	struct wcd939x_priv *wcd = dev_get_drvdata(comp->dev);
 
-	if (jack)
-		return wcd_mbhc_start(wcd->wcd_mbhc, &wcd->mbhc_cfg, jack);
+	if (jack) {
+		int ret;
+
+		ret = wcd_mbhc_start(wcd->wcd_mbhc, &wcd->mbhc_cfg, jack);
+		if (ret)
+			return ret;
+
+#if IS_ENABLED(CONFIG_TYPEC)
+		if (wcd->typec_analog_mux && wcd->typec_mode == TYPEC_MODE_AUDIO)
+			return wcd_mbhc_typec_report_plug(wcd->wcd_mbhc);
+#endif /* CONFIG_TYPEC */
+
+		return 0;
+	}
 
 	wcd_mbhc_stop(wcd->wcd_mbhc);
 
@@ -3145,17 +3159,15 @@ static int wcd939x_typec_mux_set(struct typec_mux_dev *mux,
 	struct wcd939x_priv *wcd939x = typec_mux_get_drvdata(mux);
 	unsigned int previous_mode = wcd939x->typec_mode;
 
-	if (!wcd939x->wcd_mbhc)
-		return -EINVAL;
+	wcd939x->typec_mode = state->mode;
 
-	if (wcd939x->typec_mode != state->mode) {
-		wcd939x->typec_mode = state->mode;
+	if (!wcd939x->wcd_mbhc)
+		return 0;
 
-		if (wcd939x->typec_mode == TYPEC_MODE_AUDIO)
-			return wcd_mbhc_typec_report_plug(wcd939x->wcd_mbhc);
-		else if (previous_mode == TYPEC_MODE_AUDIO)
-			return wcd_mbhc_typec_report_unplug(wcd939x->wcd_mbhc);
-	}
+	if (wcd939x->typec_mode == TYPEC_MODE_AUDIO)
+		return wcd_mbhc_typec_report_plug(wcd939x->wcd_mbhc);
+	else if (previous_mode == TYPEC_MODE_AUDIO)
+		return wcd_mbhc_typec_report_unplug(wcd939x->wcd_mbhc);
 
 	return 0;
 }
