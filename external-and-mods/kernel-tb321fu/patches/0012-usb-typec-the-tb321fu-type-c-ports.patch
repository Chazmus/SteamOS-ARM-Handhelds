diff --git a/drivers/phy/phy-nxp-ptn3222.c b/drivers/phy/phy-nxp-ptn3222.c
old mode 100644
new mode 100755
index c6179d870..34be1d903
--- a/drivers/phy/phy-nxp-ptn3222.c
+++ b/drivers/phy/phy-nxp-ptn3222.c
@@ -18,8 +18,37 @@ struct ptn3222 {
 	struct phy *phy;
 	struct gpio_desc *reset_gpio;
 	struct regulator_bulk_data *supplies;
+	u8 *param_override;
+	int param_override_len;
 };
 
+static int ptn3222_write_param_override(struct ptn3222 *ptn3222)
+{
+	struct device *dev = &ptn3222->client->dev;
+	int i, ret;
+
+	if (!ptn3222->param_override_len)
+		return 0;
+
+	if (ptn3222->param_override_len % 2) {
+		dev_warn(dev, "ignoring odd param override length %d\n",
+			 ptn3222->param_override_len);
+		return -EINVAL;
+	}
+
+	for (i = 0; i < ptn3222->param_override_len; i += 2) {
+		ret = i2c_smbus_write_byte_data(ptn3222->client,
+						ptn3222->param_override[i],
+						ptn3222->param_override[i + 1]);
+		if (ret)
+			return dev_err_probe(dev, ret,
+					     "failed to write override reg 0x%02x\n",
+					     ptn3222->param_override[i]);
+	}
+
+	return 0;
+}
+
 static int ptn3222_init(struct phy *phy)
 {
 	struct ptn3222 *ptn3222 = phy_get_drvdata(phy);
@@ -31,7 +60,9 @@ static int ptn3222_init(struct phy *phy)
 
 	gpiod_set_value_cansleep(ptn3222->reset_gpio, 0);
 
-	return 0;
+	usleep_range(1000, 2000);
+
+	return ptn3222_write_param_override(ptn3222);
 }
 
 static int ptn3222_exit(struct phy *phy)
@@ -83,6 +114,26 @@ static int ptn3222_probe(struct i2c_client *client)
 	if (ret)
 		return ret;
 
+	ptn3222->param_override_len =
+		of_property_count_u8_elems(dev->of_node,
+					   "qcom,param-override-seq-c1");
+	if (ptn3222->param_override_len > 0) {
+		ptn3222->param_override = devm_kmalloc(dev,
+						       ptn3222->param_override_len,
+						       GFP_KERNEL);
+		if (!ptn3222->param_override)
+			return -ENOMEM;
+
+		ret = of_property_read_u8_array(dev->of_node,
+						"qcom,param-override-seq-c1",
+						ptn3222->param_override,
+						ptn3222->param_override_len);
+		if (ret)
+			return ret;
+	} else if (ptn3222->param_override_len != -EINVAL) {
+		return ptn3222->param_override_len;
+	}
+
 	ptn3222->phy = devm_phy_create(dev, dev->of_node, &ptn3222_ops);
 	if (IS_ERR(ptn3222->phy)) {
 		dev_err(dev, "failed to create PHY: %d\n", ret);
diff --git a/drivers/usb/dwc3/dwc3-qcom.c b/drivers/usb/dwc3/dwc3-qcom.c
index f43f73ac3..db8d51c06 100644
--- a/drivers/usb/dwc3/dwc3-qcom.c
+++ b/drivers/usb/dwc3/dwc3-qcom.c
@@ -34,6 +34,7 @@
 #define PIPE_UTMI_CLK_SEL			BIT(0)
 #define PIPE3_PHYSTATUS_SW			BIT(3)
 #define PIPE_UTMI_CLK_DIS			BIT(8)
+#define QSCRATCH_PWR_EVNT_IRQ_STAT_1		0x1e4
 
 #define PWR_EVNT_LPM_IN_L2_MASK			BIT(4)
 #define PWR_EVNT_LPM_OUT_L2_MASK		BIT(5)
@@ -85,6 +86,8 @@ struct dwc3_qcom {
 	struct icc_path		*icc_path_apps;
 
 	enum usb_role		current_role;
+	bool			host_ss_powerup_quirk;
+	bool			host_usb2_phy_reinit_quirk;
 };
 
 #define to_dwc3_qcom(d) container_of((d), struct dwc3_qcom, dwc)
@@ -436,6 +439,96 @@ static void dwc3_qcom_select_utmi_clk(struct dwc3_qcom *qcom)
 			  PIPE_UTMI_CLK_DIS);
 }
 
+static void dwc3_qcom_host_ss_powerup_quirk(struct dwc3_qcom *qcom)
+{
+	/*
+	 * Lenovo Y700 downstream dwc3-msm performs this sequence during host
+	 * SS power-up.  It differs from select-utmi-as-pipe-clk: for the
+	 * active host path it clears PIPE_UTMI_CLK_SEL/PIPE3_PHYSTATUS_SW and
+	 * clears the second power-event LPM-out bit.
+	 */
+	dwc3_qcom_setbits(qcom->qscratch_base, QSCRATCH_GENERAL_CFG,
+			  PIPE_UTMI_CLK_DIS);
+	usleep_range(100, 1000);
+
+	dwc3_qcom_clrbits(qcom->qscratch_base, QSCRATCH_GENERAL_CFG,
+			  PIPE_UTMI_CLK_SEL | PIPE3_PHYSTATUS_SW);
+	usleep_range(100, 1000);
+
+	dwc3_qcom_clrbits(qcom->qscratch_base, QSCRATCH_GENERAL_CFG,
+			  PIPE_UTMI_CLK_DIS);
+	dwc3_qcom_clrbits(qcom->qscratch_base, QSCRATCH_PWR_EVNT_IRQ_STAT_1,
+			  PWR_EVNT_LPM_OUT_L2_MASK);
+
+	dev_dbg(qcom->dev, "applied host SS powerup quirk\n");
+}
+
+static void dwc3_qcom_reinit_usb2_phys(struct dwc3_qcom *qcom)
+{
+	struct dwc3 *dwc = &qcom->dwc;
+	struct phy *phy;
+	bool was_powered;
+	int ret;
+	int i;
+
+	for (i = 0; i < dwc->num_usb2_ports; i++) {
+		phy = dwc->usb2_generic_phy[i];
+		if (!phy)
+			continue;
+
+		dev_dbg(qcom->dev, "reinit usb2 phy%d init=%d power=%d\n",
+			i, phy->init_count, phy->power_count);
+
+		if (!phy->init_count) {
+			dev_dbg(qcom->dev,
+				"skip usb2 phy%d reinit: not initialized\n", i);
+			continue;
+		}
+
+		was_powered = phy->power_count > 0;
+		if (was_powered) {
+			ret = phy_power_off(phy);
+			if (ret) {
+				dev_warn(qcom->dev,
+					 "usb2 phy%d power off failed: %d\n",
+					 i, ret);
+				continue;
+			}
+		}
+
+		ret = phy_exit(phy);
+		if (ret) {
+			dev_warn(qcom->dev, "usb2 phy%d exit failed: %d\n",
+				 i, ret);
+			if (was_powered)
+				phy_power_on(phy);
+			continue;
+		}
+
+		usleep_range(1000, 2000);
+
+		ret = phy_init(phy);
+		if (ret) {
+			dev_warn(qcom->dev, "usb2 phy%d init failed: %d\n",
+				 i, ret);
+			continue;
+		}
+
+		if (was_powered) {
+			ret = phy_power_on(phy);
+			if (ret)
+				dev_warn(qcom->dev,
+					 "usb2 phy%d power on failed: %d\n",
+					 i, ret);
+		}
+
+		ret = phy_set_mode(phy, PHY_MODE_USB_HOST);
+		if (ret)
+			dev_warn(qcom->dev, "usb2 phy%d host mode failed: %d\n",
+				 i, ret);
+	}
+}
+
 static int dwc3_qcom_request_irq(struct dwc3_qcom *qcom, int irq,
 				 const char *name)
 {
@@ -562,8 +655,14 @@ static void dwc3_qcom_set_role_notifier(struct dwc3 *dwc, enum usb_role next_rol
 {
 	struct dwc3_qcom *qcom = to_dwc3_qcom(dwc);
 
-	if (qcom->current_role == next_role)
+	if (qcom->current_role == next_role) {
+		dev_dbg(qcom->dev, "role no-op current=%d next=%d xhci=%p\n",
+			qcom->current_role, next_role, qcom->dwc.xhci);
 		return;
+	}
+
+	dev_dbg(qcom->dev, "role change current=%d next=%d xhci=%p\n",
+		qcom->current_role, next_role, qcom->dwc.xhci);
 
 	if (pm_runtime_resume_and_get(qcom->dev)) {
 		dev_dbg(qcom->dev, "Failed to resume device\n");
@@ -575,6 +674,13 @@ static void dwc3_qcom_set_role_notifier(struct dwc3 *dwc, enum usb_role next_rol
 	else if (qcom->current_role != USB_ROLE_DEVICE)
 		dwc3_qcom_vbus_override_enable(qcom, true);
 
+	if (next_role == USB_ROLE_HOST && qcom->host_usb2_phy_reinit_quirk &&
+	    qcom->current_role == USB_ROLE_NONE)
+		dwc3_qcom_reinit_usb2_phys(qcom);
+
+	if (next_role == USB_ROLE_HOST && qcom->host_ss_powerup_quirk)
+		dwc3_qcom_host_ss_powerup_quirk(qcom);
+
 	pm_runtime_mark_last_busy(qcom->dev);
 	pm_runtime_put_sync(qcom->dev);
 
@@ -683,6 +789,11 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 	if (ignore_pipe_clk)
 		dwc3_qcom_select_utmi_clk(qcom);
 
+	qcom->host_ss_powerup_quirk = device_property_read_bool(dev,
+				"qcom,host-ss-powerup-quirk");
+	qcom->host_usb2_phy_reinit_quirk = device_property_read_bool(dev,
+				"qcom,host-usb2-phy-reinit-quirk");
+
 	qcom->mode = usb_get_dr_mode(dev);
 
 	if (qcom->mode == USB_DR_MODE_HOST) {
@@ -711,6 +822,9 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 		goto clk_disable;
 	}
 
+	if (qcom->host_ss_powerup_quirk && qcom->current_role == USB_ROLE_HOST)
+		dwc3_qcom_host_ss_powerup_quirk(qcom);
+
 	ret = dwc3_qcom_interconnect_init(qcom);
 	if (ret)
 		goto remove_core;
