# Lenovo Legion Y700 Gen 3 (TB321FU) drivers, on top of the SteamOS fragment.
CONFIG_DRM_PANEL_NOVATEK_NT36523=y
CONFIG_TOUCHSCREEN_NT36523_SPI=m
CONFIG_INPUT_AW86937_Y700=m
CONFIG_SND_SOC_AW882XX=m
CONFIG_TYPEC_MUX_PS5169=y
CONFIG_TYPEC_MUX_FSA4480=m
CONFIG_PHY_NXP_PTN3222=y
CONFIG_BACKLIGHT_KTZ8866=m
# The USB path is built in: the initramfs has no modules, and the image on a
# USB drive (the installer) has to be found before the root is mounted.
CONFIG_USB_UAS=y
