# Lenovo Legion Y700 Gen 4 (elden) drivers on top of the SM8750 config.
CONFIG_BUILTIN_DTB=y
CONFIG_BUILTIN_DTB_NAME="qcom/sm8750-lenovo-elden"
# The panel is needed before the rootfs (boot splash, Steam's first frame).
CONFIG_DRM_PANEL_NOVATEK_NT36536=y
CONFIG_TOUCHSCREEN_NOVATEK_NVT36XXX_SPI=m
CONFIG_SND_SOC_AW88461=m
CONFIG_INPUT_AW86927=m
CONFIG_PHY_NXP_PTN3222=m
CONFIG_PM8916_WATCHDOG=m
