# Lenovo Legion Tab Gen 3 (TB321FU) boot chain, from GUF296's TB321FU Linux
# work (github.com/GUF296/ubuntu-y700-build-ci). Downloaded and checked at
# build time, never committed: the UEFI carries Qualcomm's own binaries.
#
#   boot.img                Qualcomm UEFI packed as an Android boot image, so
#                           Lenovo's ABL starts UEFI. Goes to the boot partition.
#   BOOTAA64.EFI            GRUB, started by UEFI from the ESP (our ROCKNIX
#                           partition): a short menu, then QCOMRAMP.EFI.
#   QCOMRAMP-CONFIGFILE.EFI GRUB with GUF296's linuxdirect and qcomfdtmem (the
#                           memory map from Qualcomm's RAM partition table),
#                           reading EFI/BOOT/qcomramp.cfg.
# GRUB source: github.com/GUF296/grub2.
TB321FU_BOOT_SRC=https://github.com/GUF296/ubuntu-y700-build-ci
TB321FU_BOOTIMG_URL=https://raw.githubusercontent.com/GUF296/ubuntu-y700-build-ci/46ba4642c309eacb02838ad923efe9ce95ee63b8/source/boot-image/boot.img.7z
TB321FU_BOOTIMG_7Z_SHA256=a9c2e176b34d3205f8f71b5819c58d215dcb993395191d8d44f37d922f592b02
TB321FU_BOOTIMG_SHA256=45f923bc3980a8ba6e12ce606c30b4b08c2de48047626648a3d1861c95d2a58f
TB321FU_GRUB_URL=https://github.com/GUF296/ubuntu-y700-build-ci/releases/download/bootstrap-y700-20260625
TB321FU_BOOTAA64_SHA256=4d07877140000fcd3296647417b6df48583fc16f10f8833d60310d0238e00539
TB321FU_QCOMRAMP_SHA256=41115b431c9f618ea09d570ea4154c2241695e8930fb95d5ebfd406d32a4327c
# Reserved-memory nodes the direct boot drops (Android-only carve-outs).
TB321FU_DISABLE_RESERVED="/reserved-memory/qdss@82800000 /reserved-memory/splash-region /reserved-memory/trust-ui-vm@f3800000 /reserved-memory/oem-vm@f7c00000"

# Firmware, extracted from Lenovo's TB321FU stock ROM and published at
# github.com/enij90/firmware-lenovo-tb321fu; every file checked against its
# SHA256SUMS, which is pinned here.
TB321FU_FW_URL=https://github.com/enij90/firmware-lenovo-tb321fu/archive/e9a6974d6feaf2bc6dfab2da52c19d9cfc83942d.tar.gz
TB321FU_FW_SUMS_SHA256=445537b6c6b5bb236fa4c4b04c2b3ccd654b6f4ede96c7936d387bc2784aa5e2
# GUF296's device packages: the Bluetooth NVM (hmtnv20_Kirby_prc/row), the
# CSOT touch firmware and the audio profile.
TB321FU_DEBS_URL=https://github.com/GUF296/ubuntu-y700-build-ci/releases/download/bootstrap-y700-20260625/y700-device-debs-20260624-201420-compat1.tar.gz
TB321FU_DEBS_SHA256=047c1baccc420f1c28bf6d761cfc811dd7aeccfcbab6d03746ca01daf6cdfe04
