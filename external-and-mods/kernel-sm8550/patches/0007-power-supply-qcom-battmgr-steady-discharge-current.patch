From: hashtagbasit
Subject: power: supply: qcom_battmgr: steady current_now while discharging

The instantaneous battery current swings 2x from one read to the next, and
UPower takes one sample per refresh, so Steam's battery time jumped between
3 h and 10 h. While discharging, report the current the firmware's own
averaged time to empty implies (remaining charge / time left). Measured on
a Pocket FIT: steady 636 mA, UPower 6.2 h, firmware average 369 min.

---
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -465,6 +465,12 @@
 
 	mutex_lock(&battmgr->lock);
 	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, prop, 0);
+	/* current_now also needs the averaged time to empty and the remaining
+	 * charge, see qcom_battmgr_bat_get_property() */
+	if (!ret && psp == POWER_SUPPLY_PROP_CURRENT_NOW) {
+		qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_TTE_AVG, 0);
+		qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_CHG_COUNTER, 0);
+	}
 	mutex_unlock(&battmgr->lock);
 
 	return ret;
@@ -561,6 +567,22 @@
 		break;
 	case POWER_SUPPLY_PROP_CURRENT_NOW:
 		val->intval = battmgr->status.current_now;
+		/*
+		 * Discharging: the instantaneous current swings 2x from one read
+		 * to the next on a handheld, so UPower (one sample per refresh)
+		 * and Steam's battery time jumped between 3 h and 10 h. Report
+		 * the current the firmware's own averaged time to empty implies
+		 * (remaining charge / time left) instead: steady, and it agrees
+		 * with time_to_empty_avg. Not while charging, and not when the
+		 * firmware has no average (-1).
+		 */
+		if (battmgr->variant == QCOM_BATTMGR_SM8550 &&
+		    battmgr->status.current_now < 0 &&
+		    battmgr->status.capacity > 0 &&
+		    battmgr->status.discharge_time > 60 &&
+		    battmgr->status.discharge_time < 100 * 3600)
+			val->intval = -(int)div_u64((u64)battmgr->status.capacity * 3600,
+						    battmgr->status.discharge_time);
 		break;
 	case POWER_SUPPLY_PROP_POWER_NOW:
 		val->intval = battmgr->status.power_now;
