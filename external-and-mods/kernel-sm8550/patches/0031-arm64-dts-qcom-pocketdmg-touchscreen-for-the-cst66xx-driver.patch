From: hashtagbasit
Subject: arm64: dts: qcom: ayaneo-pocketdmg: touchscreen for the cst66xx driver

The DMG's touch node was written for the vendor "hyn" driver, which this
kernel doesn't carry. hynitron-cst66xx binds the same compatible but reads
the binding the Pocket S Mini uses: vdd-supply, reset-gpios and a "default"
pinctrl state. With the vendor names its 3.2 V rail was a dummy regulator
and the int/reset pins were never set up, so touch never worked. Use the
S Mini's binding, with display-coords/pos-swap turned into the standard
touchscreen size and swapped-x-y properties.

---
--- a/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pocketdmg.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayaneo-pocketdmg.dts
@@ -90,27 +90,31 @@
 	status = "okay";
 	clock-frequency = <400000>;
 
-	hynitron@5a {
-		compatible = "hyn,66xx";
+	/*
+	 * Written for the vendor "hyn" driver (vdd_ana-supply, reset-gpio,
+	 * ts_active pinctrl, display-coords/pos-swap), which this kernel
+	 * doesn't have. hynitron-cst66xx binds it instead and wants the
+	 * Pocket S Mini's binding: without vdd-supply the 3.2 V rail was a
+	 * dummy, without a "default" pinctrl state the int/reset pins were
+	 * never set up, so the DMG's touchscreen stayed dead.
+	 */
+	touchscreen@5a {
+		compatible = "hynitron,cst66xx";
 		reg = <0x5a>;
 
-		vdd_ana;
-		vdd_ana-supply = <&vreg_l14b_3p2>;
-
 		interrupt-parent = <&tlmm>;
-		interrupts = <25 0x02>;
-		reset-gpio = <&tlmm 24 0x01>;
-		irq-gpio = <&tlmm 25 0x02>;
+		interrupts = <25 IRQ_TYPE_EDGE_FALLING>;
+		reset-gpios = <&tlmm 24 GPIO_ACTIVE_LOW>;
+		vdd-supply = <&vreg_l14b_3p2>;
+
+		/* display-coords 0 0 1080 1240 with pos-swap = 1 */
+		touchscreen-size-x = <1240>;
+		touchscreen-size-y = <1080>;
+		touchscreen-swapped-x-y;
 
-		pinctrl-names = "ts_active","ts_suspend";
+		pinctrl-names = "default", "sleep";
 		pinctrl-0 = <&ts_int_active &ts_reset_active>;
 		pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
-
-		max-touch-number = <5>;
-		display-coords = <0 0 1080 1240>;
-		pos-swap = <1>;
-		posx-reverse = <0>;
-		posy-reverse = <0>;
 	};
 };
 
