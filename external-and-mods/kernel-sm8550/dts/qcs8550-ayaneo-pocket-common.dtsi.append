
/*
 * SteamOS ARM: let the SD card run at UHS-I speed (SDR50/SDR104). ROCKNIX
 * masks both modes here, so cards fell back to plain high speed (~25 MB/s)
 * and loading games from the card took about 3x as long as on the prebuilt
 * 7.0.14 kernel, which ran the same cards at SDR104.
 */
&sdhc_2 {
	/delete-property/ sdhci-caps-mask;
};
