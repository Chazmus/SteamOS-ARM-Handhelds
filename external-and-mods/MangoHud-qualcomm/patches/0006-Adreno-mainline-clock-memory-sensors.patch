+int GPU_fdinfo::get_devfreq_gpu_clock() {
+    if (!devfreq_clock_stream.is_open()) {
+        std::error_code ec;
+        for (const auto& entry : fs::directory_iterator("/sys/class/devfreq", ec)) {
+            auto name = entry.path().filename().string();
+            if (name.find("gpu") == std::string::npos)
+                continue;
+            devfreq_clock_stream.open(entry.path() / "cur_freq");
+            break;
+        }
+        if (!devfreq_clock_stream.is_open())
+            return 0;
+    }
+    std::string freq_str;
+    devfreq_clock_stream.clear();
+    devfreq_clock_stream.seekg(0);
+    std::getline(devfreq_clock_stream, freq_str);
+    if (freq_str.empty())
+        return 0;
+    return static_cast<int>(std::round(std::stoull(freq_str) / 1'000'000.0));
+}
