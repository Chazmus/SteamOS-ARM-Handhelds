From: hashtagbasit
Subject: Qualcomm: CPU temperature from a thermal zone that reads

The fallback took the first "cpuss-" thermal zone, which reads 0 on the
8 Elite, so the overlay showed 0 C for the CPU. Skip zones that read 0
and fall back to the per-core "cpu-" zones.

---
--- a/src/cpu.cpp
+++ b/src/cpu.cpp
@@ -543,18 +543,37 @@
     if (!fs::exists(sysfs_thermal))
         return;
 
+    // Qualcomm: a "cpuss-" zone first, else a per-core "cpu-" one. Only zones
+    // that read above 0: on the 8 Elite the first cpuss zone reads 0, and the
+    // overlay showed 0 C for the CPU.
+    std::string fallback_path, fallback_input;
     for (auto& d : fs::directory_iterator(sysfs_thermal)) {
         if (d.path().filename().string().substr(0, 12) != "thermal_zone")
             continue;
 
         std::string type = read_line(d / "type");
-        if (type.substr(0, 6) != "cpuss-")
+        bool cpuss = type.substr(0, 6) == "cpuss-";
+        if (!cpuss && type.substr(0, 4) != "cpu-")
             continue;
 
-        path = d.path();
-        input = d / "temp";
+        long millicelsius = 0;
+        try { millicelsius = std::stol(read_line(d / "temp")); } catch (...) {}
+        if (millicelsius <= 0)
+            continue;
 
-        return;
+        if (cpuss) {
+            path = d.path();
+            input = d / "temp";
+            return;
+        }
+        if (fallback_input.empty()) {
+            fallback_path = d.path();
+            fallback_input = d / "temp";
+        }
+    }
+    if (!fallback_input.empty()) {
+        path = fallback_path;
+        input = fallback_input;
     }
 }
 
