<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Unofficial SteamOS ARM</vendor>
  <action id="org.steamos-arm.easy-ufs-install">
    <description>Install SteamOS to internal storage</description>
    <message>Installing SteamOS to internal storage needs administrator rights</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/easy-ufs-install/install-masios-to-internal.sh</annotate>
  </action>
  <action id="org.steamos-arm.easy-ufs-probe">
    <description>Check internal storage for SteamOS</description>
    <message>Checking internal storage needs administrator rights</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/share/easy-ufs-install/ufs-probe-sizes.sh</annotate>
  </action>
</policyconfig>
